}

-- MUTATION DATA
GameData.Mutations = {
	[GameEnums.MutationType.EYES_EXTRA] = {
		DisplayName = "Extra Eyes",
		Description = "Grow additional eyes for better perception",
		VisualEffect = "AddEyeModels",
