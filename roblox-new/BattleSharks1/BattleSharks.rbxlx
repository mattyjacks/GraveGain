    <Item class="Script" referent="15">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- BattleSharks Server Initialization
-- Main entry point for the server-side game systems

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

-- Import services
local PlayerDataManager = require(script.Services.PlayerDataManager)
local GameLoopManager = require(script.Services.GameLoopManager)
local NetworkManager = require(script.Services.NetworkManager)

-- Game configuration
local GAME_CONFIG = {
	ENABLE_DEBUG = true,
	MAX_PLAYERS = 50,
	AUTO_SAVE_INTERVAL = 300, -- 5 minutes
	SERVER_VERSION = "0.1.0"
}

-- Initialize all systems
local function InitializeGame()
	print("=== BattleSharks Server Starting ===")
	print("Version:", GAME_CONFIG.SERVER_VERSION)
	print("Max Players:", GAME_CONFIG.MAX_PLAYERS)
	
	-- Set up game environment
	SetupGameEnvironment()
	
	-- Initialize core services
	PlayerDataManager.Initialize()
	GameLoopManager.Initialize()
	NetworkManager.Initialize()
	
	-- Set up periodic tasks
	SetupPeriodicTasks()
	
	-- Set up server shutdown handling
	SetupShutdownHandling()
	
	print("=== BattleSharks Server Ready ===")
end

-- Set up the game environment
local function SetupGameEnvironment()
	-- Configure workspace
	Workspace.FilteringEnabled = true
	
	-- Configure lighting
	local Lighting = game:GetService("Lighting")
	Lighting.Ambient = Color3.new(0, 0.1, 0.2)
	Lighting.Brightness = 1.5
	Lighting.GlobalShadows = true
	Lighting.Outlines = false
	Lighting.TimeOfDay = 14 -- Afternoon
	
	-- Configure sound
	local SoundService = game:GetService("SoundService")
	SoundService.RespectFilteringEnabled = true
	
	-- Configure messaging
	local MessagingService = game:GetService("MessagingService")
	
	print("Game environment configured")
end

-- Set up periodic tasks
local function SetupPeriodicTasks()
	-- Auto-save task
	task.spawn(function()
		while true do
			task.wait(GAME_CONFIG.AUTO_SAVE_INTERVAL)
			
			print("Performing auto-save...")
			PlayerDataManager.Cleanup()
			print("Auto-save completed")
		end
	end)
	
	-- Performance monitoring
	task.spawn(function()
		while true do
			task.wait(60) -- Every minute
			
			local stats = {
				PlayerCount = #Players:GetPlayers(),
				EnemyCount = GameLoopManager.GetEnemyCount(),
				ItemCount = GameLoopManager.GetItemCount(),
				ServerMemory = collectgarbage("count"),
				ElapsedTime = math.floor(tick())
			}
			
			print(string.format("Server Stats - Players: %d, Enemies: %d, Items: %d, Memory: %.2f MB", 
				stats.PlayerCount, stats.EnemyCount, stats.ItemCount, stats.ServerMemory / 1024))
		end
	end)
	
	print("Periodic tasks configured")
end

-- Set up server shutdown handling
local function SetupShutdownHandling()
	game:BindToClose(function()
		print("=== BattleSharks Server Shutting Down ===")
		
		-- Save all player data
		PlayerDataManager.Cleanup()
		
		-- Stop game loop
		GameLoopManager.Cleanup()
		
		print("=== BattleSharks Server Shutdown Complete ===")
	end)
end

-- Player connection handling
local function OnPlayerAdded(player)
	print("Player joined:", player.Name, "(" .. player.UserId .. ")")
	
	-- Wait for character to load
	player.CharacterAdded:Wait()
	
	-- Set up player-specific systems
	SetupPlayerSystems(player)
end

local function OnPlayerRemoving(player)
	print("Player left:", player.Name, "(" .. player.UserId .. ")")
end

-- Set up player-specific systems
local function SetupPlayerSystems(player)
	-- Configure player character
	local character = player.Character
	if character then
		ConfigurePlayerCharacter(character)
	end
	
	-- Set up leaderstats
	SetupLeaderstats(player)
end

-- Configure player character
local function ConfigurePlayerCharacter(character)
	-- Wait for humanoid
	local humanoid = character:WaitForChild("Humanoid")
	
	-- Configure humanoid properties
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.WalkSpeed = 16
	humanoid.JumpPower = 50
	humanoid.AutoRotate = true
	
	-- Set up character appearance
	SetCharacterAppearance(character)
end

-- Set character appearance based on class
local function SetCharacterAppearance(character)
	-- Default shark appearance
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return end
	
	-- Create shark model (placeholder)
	local sharkBody = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
	if sharkBody then
		-- Apply shark-like appearance
		sharkBody.BrickColor = BrickColor.new("Medium stone gray")
		
		-- Add fins (placeholder)
		local leftFin = Instance.new("Part")
		leftFin.Name = "LeftFin"
		leftFin.Size = Vector3.new(1, 3, 0.5)
		leftFin.BrickColor = BrickColor.new("Medium stone gray")
		leftFin.Material = Enum.Material.Plastic
		
		local leftFinWeld = Instance.new("Weld")
		leftFinWeld.Part0 = sharkBody
		leftFinWeld.Part1 = leftFin
		leftFinWeld.C0 = CFrame.new(-2, 0, 0)
		leftFinWeld.Parent = leftFin
		
		leftFin.Parent = character
		
		local rightFin = Instance.new("Part")
		rightFin.Name = "RightFin"
		rightFin.Size = Vector3.new(1, 3, 0.5)
		rightFin.BrickColor = BrickColor.new("Medium stone gray")
		rightFin.Material = Enum.Material.Plastic
		
		local rightFinWeld = Instance.new("Weld")
		rightFinWeld.Part0 = sharkBody
		rightFinWeld.Part1 = rightFin
		rightFinWeld.C0 = CFrame.new(2, 0, 0)
		rightFinWeld.Parent = rightFin
		
		rightFin.Parent = character
		
		-- Add tail fin
		local tailFin = Instance.new("Part")
		tailFin.Name = "TailFin"
		tailFin.Size = Vector3.new(0.5, 4, 2)
		tailFin.BrickColor = BrickColor.new("Medium stone gray")
		tailFin.Material = Enum.Material.Plastic
		
		local tailFinWeld = Instance.new("Weld")
		tailFinWeld.Part0 = sharkBody
		tailFinWeld.Part1 = tailFin
		tailFinWeld.C0 = CFrame.new(0, 0, -3)
		tailFinWeld.Parent = tailFin
		
		tailFin.Parent = character
	end
end

-- Set up leaderstats
local function SetupLeaderstats(player)
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player
	
	-- Level stat
	local level = Instance.new("IntValue")
	level.Name = "Level"
	level.Value = 1
	level.Parent = leaderstats
	
	-- Gold stat
	local gold = Instance.new("IntValue")
	gold.Name = "🪙 Gold"
	gold.Value = 0
	gold.Parent = leaderstats
	
	-- Kills stat
	local kills = Instance.new("IntValue")
	kills.Name = "Kills"
	kills.Value = 0
	kills.Parent = leaderstats
end

-- Update leaderstats
local function UpdateLeaderstats(player)
	local PlayerDataManager = require(script.Services.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then return end
	
	-- Update level
	local levelStat = leaderstats:FindFirstChild("Level")
	if levelStat then
		levelStat.Value = data.Level
	end
	
	-- Update gold
	local goldStat = leaderstats:FindFirstChild("🪙 Gold")
	if goldStat then
		goldStat.Value = data.Gold
	end
	
	-- Update kills
	local killsStat = leaderstats:FindFirstChild("Kills")
	if killsStat then
		killsStat.Value = data.EnemiesKilled
	end
end

-- Connect player events
Players.PlayerAdded:Connect(OnPlayerAdded)
Players.PlayerRemoving:Connect(OnPlayerRemoving)

-- Update leaderstats periodically
task.spawn(function()
	while true do
		task.wait(5) -- Update every 5 seconds
		
		for _, player in pairs(Players:GetPlayers()) do
			UpdateLeaderstats(player)
		end
	end
end)

-- Start the game
InitializeGame()
]]></string>
      </Properties>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">GameLoopManager</string>
            <string name="Source"><![CDATA[-- BattleSharks Game Loop Manager
-- Manages the main game loop, enemy spawning, and world state

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

local GameConstants = require(script.Parent.Parent.Parent.Shared.Constants.GameConstants)
local GameEnums = require(script.Parent.Parent.Parent.Shared.Enums.GameEnums)
local GameData = require(script.Parent.Parent.Parent.Shared.Data.GameData)
local GameUtilities = require(script.Parent.Parent.Parent.Shared.Utilities.GameUtilities)

local GameLoopManager = {}

-- PRIVATE VARIABLES
local isRunning = false
local gameLoopConnection = nil
local enemies = {}
local items = {}
local worldObjects = {}

-- SPAWN CONFIGURATION
local spawnConfig = {
	EnemySpawnRate = 2.0, -- seconds between spawns
	MaxEnemies = 50,
	SpawnRadius = 500, -- studs from player
	DespawnRadius = 1000, -- studs to despawn
	ItemSpawnRate = 1.5, -- seconds between item spawns
	MaxItems = 30
}

-- INITIALIZATION
function GameLoopManager.Initialize()
	GameUtilities.DebugPrint("GameLoopManager: Initializing")
	
	-- Create ocean environment
	GameLoopManager.CreateOceanEnvironment()
	
	-- Set up game loop
	GameLoopManager.StartGameLoop()
	
	GameUtilities.DebugPrint("GameLoopManager: Initialized")
end

-- OCEAN ENVIRONMENT
function GameLoopManager.CreateOceanEnvironment()
	-- Create ocean floor
	local oceanFloor = Instance.new("Part")
	oceanFloor.Name = "OceanFloor"
	oceanFloor.Size = Vector3.new(GameConstants.OCEAN_SIZE.X, 20, GameConstants.OCEAN_SIZE.Y)
	oceanFloor.Position = Vector3.new(0, GameConstants.OCEAN_DEPTH, 0)
	oceanFloor.Anchored = true
	oceanFloor.Locked = true
	oceanFloor.BrickColor = BrickColor.new("Sand blue")
	oceanFloor.TopSurface = Enum.SurfaceType.Smooth
	oceanFloor.BottomSurface = Enum.SurfaceType.Smooth
	oceanFloor.Parent = Workspace
	
	-- Create water boundaries
	local boundaries = {
		{Vector3.new(0, 0, GameConstants.OCEAN_SIZE.Y/2), Vector3.new(GameConstants.OCEAN_SIZE.X, 100, 20), "North"},
		{Vector3.new(0, 0, -GameConstants.OCEAN_SIZE.Y/2), Vector3.new(GameConstants.OCEAN_SIZE.X, 100, 20), "South"},
		{Vector3.new(GameConstants.OCEAN_SIZE.X/2, 0, 0), Vector3.new(20, 100, GameConstants.OCEAN_SIZE.Y), "East"},
		{Vector3.new(-GameConstants.OCEAN_SIZE.X/2, 0, 0), Vector3.new(20, 100, GameConstants.OCEAN_SIZE.Y), "West"}
	}
	
	for _, boundary in pairs(boundaries) do
		local wall = Instance.new("Part")
		wall.Name = "Boundary_" .. boundary[3]
		wall.Position = boundary[1]
		wall.Size = boundary[2]
		wall.Anchored = true
		wall.Locked = true
		wall.BrickColor = BrickColor.new("Rock")
		wall.Transparency = 0.8
		wall.CanCollide = true
		wall.Parent = Workspace
	end
	
	-- Create decorative elements
	GameLoopManager.CreateDecorativeElements()
end

function GameLoopManager.CreateDecorativeElements()
	-- Create coral formations
	for i = 1, 20 do
		local coral = Instance.new("Model")
		coral.Name = "Coral_" .. i
		
		-- Simple coral shape
		local base = Instance.new("Part")
		base.Name = "Base"
		base.Size = Vector3.new(2, 4, 2)
		base.BrickColor = BrickColor.new("Pink")
		base.Material = Enum.Material.Neon
		base.Anchored = true
		
		-- Random position within ocean
		local x = GameUtilities.RandomFloat(-GameConstants.OCEAN_SIZE.X/3, GameConstants.OCEAN_SIZE.X/3)
		local z = GameUtilities.RandomFloat(-GameConstants.OCEAN_SIZE.Y/3, GameConstants.OCEAN_SIZE.Y/3)
		base.Position = Vector3.new(x, GameConstants.OCEAN_DEPTH + 10, z)
		
		base.Parent = coral
		coral.Parent = Workspace
	end
	
	-- Create seaweed
	for i = 1, 30 do
		local seaweed = Instance.new("Model")
		seaweed.Name = "Seaweed_" .. i
		
		for j = 1, 3 do
			local segment = Instance.new("Part")
			segment.Name = "Segment_" .. j
			segment.Size = Vector3.new(1, 3, 1)
			segment.BrickColor = BrickColor.new("Dark green")
			segment.Material = Enum.Material.Grass
			segment.Anchored = true
			
			local x = GameUtilities.RandomFloat(-GameConstants.OCEAN_SIZE.X/3, GameConstants.OCEAN_SIZE.X/3)
			local z = GameUtilities.RandomFloat(-GameConstants.OCEAN_SIZE.Y/3, GameConstants.OCEAN_SIZE.Y/3)
			segment.Position = Vector3.new(x, GameConstants.OCEAN_DEPTH + 5 + j * 3, z)
			
			segment.Parent = seaweed
		end
		
		seaweed.Parent = Workspace
	end
	
	-- Create bubbles
	GameLoopManager.CreateBubbleSystem()
end

function GameLoopManager.CreateBubbleSystem()
	-- Create bubble spawner
	task.spawn(function()
		while true do
			task.wait(GameUtilities.RandomFloat(1, 3))
			
			-- Create bubble
			local bubble = Instance.new("Part")
			bubble.Name = "Bubble"
			bubble.Size = Vector3.new(0.5, 0.5, 0.5)
			bubble.Shape = Enum.PartType.Ball
			bubble.Material = Enum.Material.Glass
			bubble.Transparency = 0.3
			bubble.BrickColor = BrickColor.new("Light blue")
			bubble.CanCollide = false
			bubble.Anchored = false
			
			-- Random position
			local x = GameUtilities.RandomFloat(-GameConstants.OCEAN_SIZE.X/2, GameConstants.OCEAN_SIZE.X/2)
			local z = GameUtilities.RandomFloat(-GameConstants.OCEAN_SIZE.Y/2, GameConstants.OCEAN_SIZE.Y/2)
			bubble.Position = Vector3.new(x, GameConstants.OCEAN_DEPTH, z)
			
			-- Add upward force
			local bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.Velocity = Vector3.new(0, 5, 0)
			bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
			bodyVelocity.Parent = bubble
			
			bubble.Parent = Workspace
			
			-- Remove bubble after it reaches surface
			task.wait(10)
			if bubble then
				bubble:Destroy()
			end
		end
	end)
end

-- GAME LOOP
function GameLoopManager.StartGameLoop()
	if isRunning then
		GameUtilities.LogWarning("GameLoopManager: Game loop is already running")
		return
	end
	
	isRunning = true
	GameUtilities.DebugPrint("GameLoopManager: Starting game loop")
	
	gameLoopConnection = RunService.Heartbeat:Connect(function(deltaTime)
		GameLoopManager.UpdateGameLoop(deltaTime)
	end)
end

function GameLoopManager.StopGameLoop()
	if not isRunning then
		return
	end
	
	isRunning = false
	if gameLoopConnection then
		gameLoopConnection:Disconnect()
		gameLoopConnection = nil
	end
	
	GameUtilities.DebugPrint("GameLoopManager: Stopped game loop")
end

function GameLoopManager.UpdateGameLoop(deltaTime)
	-- Update enemies
	GameLoopManager.UpdateEnemies(deltaTime)
	
	-- Update items
	GameLoopManager.UpdateItems(deltaTime)
	
	-- Spawn new enemies
	if #enemies < spawnConfig.MaxEnemies then
		GameLoopManager.TrySpawnEnemy()
	end
	
	-- Spawn new items
	if #items < spawnConfig.MaxItems then
		GameLoopManager.TrySpawnItem()
	end
	
	-- Clean up distant objects
	GameLoopManager.CleanupDistantObjects()
end

-- ENEMY MANAGEMENT
function GameLoopManager.TrySpawnEnemy()
	local player = GameLoopManager.GetRandomPlayer()
	if not player then return end
	
	local character = player.Character
	if not character then return end
	
	local playerPosition = character.PrimaryPart.Position
	
	-- Find spawn position
	local spawnPosition = GameLoopManager.FindSpawnPosition(playerPosition, spawnConfig.SpawnRadius)
	if not spawnPosition then return end
	
	-- Choose enemy type
	local enemyType = GameLoopManager.ChooseEnemyType()
	
	-- Spawn enemy
	GameLoopManager.SpawnEnemy(enemyType, spawnPosition)
end

function GameLoopManager.FindSpawnPosition(centerPosition, radius)
	local maxAttempts = 10
	
	for attempt = 1, maxAttempts do
		local angle = math.random() * math.pi * 2
		local distance = GameUtilities.RandomFloat(radius * 0.5, radius)
		
		local x = centerPosition.X + math.cos(angle) * distance
		local z = centerPosition.Z + math.sin(angle) * distance
		local y = GameUtilities.RandomFloat(GameConstants.OCEAN_DEPTH + 10, GameConstants.WATER_LEVEL - 10)
		
		local spawnPosition = Vector3.new(x, y, z)
		
		-- Check if position is valid (not too close to other enemies)
		local valid = true
		for _, enemy in pairs(enemies) do
			if enemy.Model and enemy.Model.PrimaryPart then
				local distance = (spawnPosition - enemy.Model.PrimaryPart.Position).Magnitude
				if distance < 20 then
					valid = false
					break
				end
			end
		end
		
		if valid then
			return spawnPosition
		end
	end
	
	return nil
end

function GameLoopManager.ChooseEnemyType()
	-- Weighted random selection based on player level
	local player = GameLoopManager.GetRandomPlayer()
	local playerLevel = 1
	
	if player then
		local PlayerDataManager = require(script.Parent.PlayerDataManager)
		local data = PlayerDataManager.GetPlayerData(player.UserId)
		if data then
			playerLevel = data.Level
		end
	end
	
	local choices = {}
	
	-- Add common enemies
	for enemyType, enemyData in pairs(GameData.Enemies) do
		local weight = 1
		
		-- Adjust weight based on player level
		if enemyData.XP <= playerLevel * 5 then
			weight = 3 -- More likely to spawn weaker enemies
		elseif enemyData.XP <= playerLevel * 15 then
			weight = 2 -- Medium chance for balanced enemies
		else
			weight = 0.5 -- Less likely for strong enemies
		end
		
		table.insert(choices, {Value = enemyType, Weight = weight})
	end
	
	return GameUtilities.WeightedRandomChoice(choices)
end

function GameLoopManager.SpawnEnemy(enemyType, position)
	local enemyData = GameData.Enemies[enemyType]
	if not enemyData then return nil end
	
	-- Create enemy model
	local model = Instance.new("Model")
	model.Name = enemyData.DisplayName
	
	-- Create main part
	local mainPart = Instance.new("Part")
	mainPart.Name = "Head"
	mainPart.Size = enemyData.Size
	mainPart.Position = position
	mainPart.BrickColor = BrickColor.new("Medium stone gray")
	mainPart.Material = Enum.Material.Plastic
	mainPart.Anchored = false
	mainPart.CanCollide = true
	
	-- Add humanoid
	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = enemyData.Health
	humanoid.Health = enemyData.Health
	humanoid.WalkSpeed = enemyData.Speed
	humanoid.Parent = model
	
	-- Add health display
	local healthTag = Instance.new("BillboardGui")
	healthTag.Name = "HealthTag"
	healthTag.Size = UDim2.new(0, 100, 0, 20)
	healthTag.StudsOffset = Vector3.new(0, 3, 0)
	healthTag.Parent = mainPart
	
	local healthBar = Instance.new("Frame")
	healthBar.Name = "HealthBar"
	healthBar.Size = UDim2.new(1, 0, 1, 0)
	healthBar.BackgroundColor3 = Color3.new(1, 0, 0)
	healthBar.Parent = healthTag
	
	mainPart.Parent = model
	model.Parent = Workspace
	
	-- Create enemy object
	local enemy = {
		Type = enemyType,
		Model = model,
		Data = enemyData,
		Health = enemyData.Health,
		MaxHealth = enemyData.Health,
		State = "Idle",
		Target = nil,
		SpawnTime = tick(),
		LastAttack = 0
	}
	
	table.insert(enemies, enemy)
	
	-- Start AI
	GameLoopManager.StartEnemyAI(enemy)
	
	return enemy
end

function GameLoopManager.StartEnemyAI(enemy)
	task.spawn(function()
		while enemy.Model and enemy.Model.Parent do
			task.wait(0.1) -- AI update rate
			
			if not enemy.Model or not enemy.Model.Parent then break end
			
			-- Update AI state
			GameLoopManager.UpdateEnemyAI(enemy)
		end
		
		-- Clean up
		GameLoopManager.RemoveEnemy(enemy)
	end)
end

function GameLoopManager.UpdateEnemyAI(enemy)
	if not enemy.Model or not enemy.Model.PrimaryPart then return end
	
	local enemyPosition = enemy.Model.PrimaryPart.Position
	
	-- Find nearest player
	local nearestPlayer = GameLoopManager.GetNearestPlayer(enemyPosition)
	
	if nearestPlayer and nearestPlayer.Character then
		local playerPosition = nearestPlayer.Character.PrimaryPart.Position
		local distance = (playerPosition - enemyPosition).Magnitude
		
		enemy.Target = nearestPlayer
		
		if distance <= enemy.Data.Range or distance <= 50 then
			-- Attack state
			enemy.State = "Attack"
			GameLoopManager.EnemyAttack(enemy, nearestPlayer)
		elseif distance <= 200 then
			-- Chase state
			enemy.State = "Chase"
			GameLoopManager.EnemyChase(enemy, nearestPlayer)
		else
			-- Idle state
			enemy.State = "Idle"
			GameLoopManager.EnemyIdle(enemy)
		end
	else
		-- No target, idle
		enemy.State = "Idle"
		enemy.Target = nil
		GameLoopManager.EnemyIdle(enemy)
	end
end

function GameLoopManager.EnemyIdle(enemy)
	-- Random movement
	if math.random() < 0.1 then -- 10% chance to change direction
		local humanoid = enemy.Model:FindFirstChild("Humanoid")
		if humanoid then
			local direction = Vector3.new(
				GameUtilities.RandomFloat(-1, 1),
				0,
				GameUtilities.RandomFloat(-1, 1)
			).Unit
			
			humanoid:Move(direction * enemy.Data.Speed * 0.3)
		end
	end
end

function GameLoopManager.EnemyChase(enemy, target)
	if not target or not target.Character then return end
	
	local humanoid = enemy.Model:FindFirstChild("Humanoid")
	if not humanoid then return end
	
	local enemyPosition = enemy.Model.PrimaryPart.Position
	local targetPosition = target.Character.PrimaryPart.Position
	local direction = (targetPosition - enemyPosition).Unit
	
	humanoid:Move(direction * enemy.Data.Speed)
end

function GameLoopManager.EnemyAttack(enemy, target)
	if not target or not target.Character then return end
	
	local currentTime = tick()
	local attackCooldown = enemy.Data.Cooldown or 2.0
	
	if currentTime - enemy.LastAttack < attackCooldown then return end
	
	local enemyPosition = enemy.Model.PrimaryPart.Position
	local targetPosition = target.Character.PrimaryPart.Position
	local distance = (targetPosition - enemyPosition).Magnitude
	
	if distance <= (enemy.Data.Range or 10) then
		-- Deal damage
		local PlayerDataManager = require(script.Parent.PlayerDataManager)
		PlayerDataManager.DamagePlayer(target, enemy.Data.Damage, GameEnums.DamageType.PHYSICAL)
		
		enemy.LastAttack = currentTime
		
		-- Visual effect
		GameLoopManager.CreateAttackEffect(enemyPosition, targetPosition)
	end
end

function GameLoopManager.CreateAttackEffect(from, to)
	-- Create simple attack trail
	local trail = Instance.new("Part")
	trail.Name = "AttackTrail"
	trail.Size = Vector3.new(1, 1, (from - to).Magnitude)
	trail.Position = from:Lerp(to, 0.5)
	trail.BrickColor = BrickColor.new("Bright red")
	trail.Material = Enum.Material.Neon
	trail.Transparency = 0.5
	trail.Anchored = true
	trail.CanCollide = false
	
	-- Point towards target
	trail.CFrame = CFrame.new(trail.Position, to)
	
	trail.Parent = Workspace
	
	-- Remove after short time
	task.wait(0.2)
	if trail then
		trail:Destroy()
	end
end

function GameLoopManager.UpdateEnemies(deltaTime)
	for i = #enemies, 1, -1 do
		local enemy = enemies[i]
		
		if not enemy.Model or not enemy.Model.Parent then
			table.remove(enemies, i)
		elseif enemy.Health <= 0 then
			GameLoopManager.OnEnemyDied(enemy)
			table.remove(enemies, i)
		end
	end
end

function GameLoopManager.OnEnemyDied(enemy)
	-- Award XP and gold to nearby players
	local enemyPosition = enemy.Model.PrimaryPart.Position
	
	for _, player in pairs(Players:GetPlayers()) do
		if player.Character and player.Character.PrimaryPart then
			local distance = (player.Character.PrimaryPart.Position - enemyPosition).Magnitude
			if distance <= 200 then -- Award range
				local PlayerDataManager = require(script.Parent.PlayerDataManager)
				PlayerDataManager.AddXP(player, enemy.Data.XP)
				PlayerDataManager.AddCurrency(player, GameEnums.CurrencyType.GOLD, enemy.Data.Gold)
				
				-- Update statistics
				local data = PlayerDataManager.GetPlayerData(player.UserId)
				if data then
					data.Statistics.TotalDamageDealt += enemy.Data.MaxHealth
					data.EnemiesKilled += 1
				end
			end
		end
	end
	
	-- Drop loot
	GameLoopManager.DropLoot(enemy)
	
	-- Visual effects
	GameLoopManager.CreateDeathEffect(enemy)
	
	-- Remove model
	if enemy.Model then
		enemy.Model:Destroy()
	end
end

function GameLoopManager.DropLoot(enemy)
	-- Chance to drop items
	if math.random() < 0.3 then -- 30% chance
		local lootPosition = enemy.Model.PrimaryPart.Position
		
		-- Choose random item
		local itemChoices = {}
		for itemName, itemData in pairs(GameData.Items) do
			if itemData.Type == GameEnums.ItemType.FOOD or itemData.Type == GameEnums.ItemType.POTION then
				table.insert(itemChoices, itemName)
			end
		end
		
		if #itemChoices > 0 then
			local chosenItem = itemChoices[math.random(1, #itemChoices)]
			GameLoopManager.SpawnItem(chosenItem, lootPosition)
		end
	end
end

function GameLoopManager.CreateDeathEffect(enemy)
	-- Simple death effect
	local position = enemy.Model.PrimaryPart.Position
	
	for i = 1, 5 do
		local particle = Instance.new("Part")
		particle.Name = "DeathParticle"
		particle.Size = Vector3.new(0.5, 0.5, 0.5)
		particle.Shape = Enum.PartType.Ball
		particle.BrickColor = BrickColor.new("Bright red")
		particle.Material = Enum.Material.Neon
		particle.Anchored = false
		particle.CanCollide = false
		
		local offset = Vector3.new(
			GameUtilities.RandomFloat(-2, 2),
			GameUtilities.RandomFloat(0, 3),
			GameUtilities.RandomFloat(-2, 2)
		)
		particle.Position = position + offset
		
		-- Add random velocity
		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Velocity = Vector3.new(
			GameUtilities.RandomFloat(-5, 5),
			GameUtilities.RandomFloat(2, 8),
			GameUtilities.RandomFloat(-5, 5)
		)
		bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
		bodyVelocity.Parent = particle
		
		particle.Parent = Workspace
		
		-- Remove after time
		task.delay(2, function()
			if particle then
				particle:Destroy()
			end
		end)
	end
end

function GameLoopManager.RemoveEnemy(enemy)
	for i, e in pairs(enemies) do
		if e == enemy then
			table.remove(enemies, i)
			break
		end
	end
	
	if enemy.Model then
		enemy.Model:Destroy()
	end
end

-- ITEM MANAGEMENT
function GameLoopManager.TrySpawnItem()
	local player = GameLoopManager.GetRandomPlayer()
	if not player then return end
	
	local character = player.Character
	if not character then return end
	
	local playerPosition = character.PrimaryPart.Position
	
	-- Find spawn position
	local spawnPosition = GameLoopManager.FindSpawnPosition(playerPosition, spawnConfig.SpawnRadius * 0.7)
	if not spawnPosition then return end
	
	-- Choose item type
	local itemChoices = {}
	for itemName, itemData in pairs(GameData.Items) do
		if itemData.Type == GameEnums.ItemType.FOOD then
			table.insert(itemChoices, itemName)
		end
	end
	
	if #itemChoices == 0 then return end
	
	local chosenItem = itemChoices[math.random(1, #itemChoices)]
	
	-- Spawn item
	GameLoopManager.SpawnItem(chosenItem, spawnPosition)
end

function GameLoopManager.SpawnItem(itemName, position)
	local itemData = GameData.Items[itemName]
	if not itemData then return nil end
	
	-- Create item model
	local model = Instance.new("Model")
	model.Name = itemData.DisplayName
	
	-- Create main part
	local mainPart = Instance.new("Part")
	mainPart.Name = "Item"
	mainPart.Size = Vector3.new(2, 2, 2)
	mainPart.Position = position
	mainPart.BrickColor = BrickColor.new("Bright green")
	mainPart.Material = Enum.Material.Neon
	mainPart.Anchored = true
	mainPart.CanCollide = false
	
	-- Add floating animation
	local bodyVelocity = Instance.new("BodyVelocity")
	bodyVelocity.Velocity = Vector3.new(0, 1, 0)
	bodyVelocity.MaxForce = Vector3.new(0, math.huge, 0)
	bodyVelocity.Parent = mainPart
	
	-- Add glow effect
	local pointLight = Instance.new("PointLight")
	pointLight.Color = Color3.new(0, 1, 0)
	pointLight.Range = 10
	pointLight.Brightness = 2
	pointLight.Parent = mainPart
	
	mainPart.Parent = model
	model.Parent = Workspace
	
	-- Create item object
	local item = {
		Name = itemName,
		Data = itemData,
		Model = model,
		SpawnTime = tick()
	}
	
	table.insert(items, item)
	
	-- Set up collection
	GameLoopManager.SetupItemCollection(item)
	
	return item
end

function GameLoopManager.SetupItemCollection(item)
	local collectionRadius = 5
	
	-- Check for player proximity
	task.spawn(function()
		while item.Model and item.Model.Parent do
			task.wait(0.5)
			
			if not item.Model or not item.Model.PrimaryPart then break end
			
			local itemPosition = item.Model.PrimaryPart.Position
			
			for _, player in pairs(Players:GetPlayers()) do
				if player.Character and player.Character.PrimaryPart then
					local distance = (player.Character.PrimaryPart.Position - itemPosition).Magnitude
					if distance <= collectionRadius then
						GameLoopManager.CollectItem(player, item)
						break
					end
				end
			end
		end
		
		-- Clean up
		GameLoopManager.RemoveItem(item)
	end)
end

function GameLoopManager.CollectItem(player, item)
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	
	-- Add item to player inventory
	local success = PlayerDataManager.AddItem(player, item.Data, 1)
	
	if success then
		-- Update statistics
		local data = PlayerDataManager.GetPlayerData(player.UserId)
		if data then
			data.FoodEaten += 1
		end
		
		-- Visual effect
		GameLoopManager.CreateCollectionEffect(item.Model.PrimaryPart.Position)
		
		-- Remove item
		GameLoopManager.RemoveItem(item)
		
		GameUtilities.DebugPrint("GameLoopManager: " .. player.Name .. " collected " .. item.Data.DisplayName)
	end
end

function GameLoopManager.CreateCollectionEffect(position)
	-- Simple collection effect
	local effect = Instance.new("Part")
	effect.Name = "CollectionEffect"
	effect.Size = Vector3.new(1, 1, 1)
	effect.Shape = Enum.PartType.Ball
	effect.BrickColor = BrickColor.new("Bright green")
	effect.Material = Enum.Material.Neon
	effect.Anchored = true
	effect.CanCollide = false
	effect.Position = position
	
	-- Animate
	local startSize = effect.Size
	local endSize = Vector3.new(5, 5, 5)
	
	for i = 1, 20 do
		local progress = i / 20
		effect.Size = startSize:Lerp(endSize, progress)
		effect.Transparency = progress
		task.wait(0.05)
	end
	
	effect:Destroy()
end

function GameLoopManager.UpdateItems(deltaTime)
	for i = #items, 1, -1 do
		local item = items[i]
		
		if not item.Model or not item.Model.Parent then
			table.remove(items, i)
		elseif tick() - item.SpawnTime > 300 then -- Despawn after 5 minutes
			GameLoopManager.RemoveItem(item)
			table.remove(items, i)
		end
	end
end

function GameLoopManager.RemoveItem(item)
	for i, it in pairs(items) do
		if it == item then
			table.remove(items, i)
			break
		end
	end
	
	if item.Model then
		item.Model:Destroy()
	end
end

-- UTILITY FUNCTIONS
function GameLoopManager.GetRandomPlayer()
	local playerList = Players:GetPlayers()
	if #playerList == 0 then return nil end
	
	return playerList[math.random(1, #playerList)]
end

function GameLoopManager.GetNearestPlayer(position)
	local nearestPlayer = nil
	local nearestDistance = math.huge
	
	for _, player in pairs(Players:GetPlayers()) do
		if player.Character and player.Character.PrimaryPart then
			local distance = (player.Character.PrimaryPart.Position - position).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestPlayer = player
			end
		end
	end
	
	return nearestPlayer
end

function GameLoopManager.CleanupDistantObjects()
	local player = GameLoopManager.GetRandomPlayer()
	if not player then return end
	
	local playerPosition = player.Character.PrimaryPart.Position
	
	-- Clean up distant enemies
	for i = #enemies, 1, -1 do
		local enemy = enemies[i]
		if enemy.Model and enemy.Model.PrimaryPart then
			local distance = (enemy.Model.PrimaryPart.Position - playerPosition).Magnitude
			if distance > spawnConfig.DespawnRadius then
				GameLoopManager.RemoveEnemy(enemy)
				table.remove(enemies, i)
			end
		end
	end
	
	-- Clean up distant items
	for i = #items, 1, -1 do
		local item = items[i]
		if item.Model and item.Model.PrimaryPart then
			local distance = (item.Model.PrimaryPart.Position - playerPosition).Magnitude
			if distance > spawnConfig.DespawnRadius then
				GameLoopManager.RemoveItem(item)
				table.remove(items, i)
			end
		end
	end
end

-- PUBLIC API
function GameLoopManager.GetEnemies()
	return enemies
end

function GameLoopManager.GetItems()
	return items
end

function GameLoopManager.GetEnemyCount()
	return #enemies
end

function GameLoopManager.GetItemCount()
	return #items
end

-- CLEANUP
function GameLoopManager.Cleanup()
	GameLoopManager.StopGameLoop()
	
	-- Clean up all enemies
	for _, enemy in pairs(enemies) do
		if enemy.Model then
			enemy.Model:Destroy()
		end
	end
	enemies = {}
	
	-- Clean up all items
	for _, item in pairs(items) do
		if item.Model then
			item.Model:Destroy()
		end
	end
	items = {}
	
	GameUtilities.DebugPrint("GameLoopManager: Cleaned up")
end

return GameLoopManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">NetworkManager</string>
            <string name="Source"><![CDATA[-- BattleSharks Network Manager
-- Handles all client-server communication

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local RemoteNames = require(script.Parent.Parent.Parent.Shared.Networking.RemoteNames)
local GameUtilities = require(script.Parent.Parent.Parent.Shared.Utilities.GameUtilities)

local NetworkManager = {}

-- PRIVATE VARIABLES
local remoteEvents = {}
local remoteFunctions = {}

-- INITIALIZATION
function NetworkManager.Initialize()
	GameUtilities.DebugPrint("NetworkManager: Initializing")
	
	-- Create remote events
	NetworkManager.CreateRemoteEvents()
	
	-- Create remote functions
	NetworkManager.CreateRemoteFunctions()
	
	-- Set up event handlers
	NetworkManager.SetupEventHandlers()
	
	GameUtilities.DebugPrint("NetworkManager: Initialized")
end

-- REMOTE EVENTS CREATION
function NetworkManager.CreateRemoteEvents()
	local remoteFolder = ReplicatedStorage:FindFirstChild("BattleSharksRemotes")
	if not remoteFolder then
		remoteFolder = Instance.new("Folder")
		remoteFolder.Name = "BattleSharksRemotes"
		remoteFolder.Parent = ReplicatedStorage
	end
	
	-- Create all client-to-server remote events
	for eventName, _ in pairs(RemoteNames.ClientToServer) do
		local remote = Instance.new("RemoteEvent")
		remote.Name = eventName
		remote.Parent = remoteFolder
		remoteEvents[eventName] = remote
	end
	
	-- Create all server-to-client remote events
	for eventName, _ in pairs(RemoteNames.ServerToClient) do
		local remote = Instance.new("RemoteEvent")
		remote.Name = eventName
		remote.Parent = remoteFolder
		remoteEvents[eventName] = remote
	end
	
	GameUtilities.DebugPrint("NetworkManager: Created " .. GameUtilities.GetTableSize(remoteEvents) .. " remote events")
end

function NetworkManager.CreateRemoteFunctions()
	local remoteFolder = ReplicatedStorage:FindFirstChild("BattleSharksRemotes")
	
	-- Create all client-to-server remote functions
	for functionName, _ in pairs(RemoteNames.ClientFunctions) do
		local remote = Instance.new("RemoteFunction")
		remote.Name = functionName
		remote.Parent = remoteFolder
		remoteFunctions[functionName] = remote
	end
	
	-- Create all server-to-client remote functions
	for functionName, _ in pairs(RemoteNames.ServerFunctions) do
		local remote = Instance.new("RemoteFunction")
		remote.Name = functionName
		remote.Parent = remoteFolder
		remoteFunctions[functionName] = remote
	end
	
	GameUtilities.DebugPrint("NetworkManager: Created " .. GameUtilities.GetTableSize(remoteFunctions) .. " remote functions")
end

-- EVENT HANDLERS
function NetworkManager.SetupEventHandlers()
	-- Player Actions
	NetworkManager.ConnectEvent("PlayerSpawn", NetworkManager.HandlePlayerSpawn)
	NetworkManager.ConnectEvent("PlayerMove", NetworkManager.HandlePlayerMove)
	NetworkManager.ConnectEvent("PlayerAttack", NetworkManager.HandlePlayerAttack)
	NetworkManager.ConnectEvent("PlayerBoost", NetworkManager.HandlePlayerBoost)
	NetworkManager.ConnectEvent("PlayerInteract", NetworkManager.HandlePlayerInteract)
	
	-- Game Systems
	NetworkManager.ConnectEvent("FeedShark", NetworkManager.HandleFeedShark)
	NetworkManager.ConnectEvent("CleanAquarium", NetworkManager.HandleCleanAquarium)
	NetworkManager.ConnectEvent("ApplyMutation", NetworkManager.HandleApplyMutation)
	NetworkManager.ConnectEvent("ChangeClass", NetworkManager.HandleChangeClass)
	NetworkManager.ConnectEvent("UseItem", NetworkManager.HandleUseItem)
	NetworkManager.ConnectEvent("BuyItem", NetworkManager.HandleBuyItem)
	NetworkManager.ConnectEvent("SellItem", NetworkManager.HandleSellItem)
	
	-- Inventory Management
	NetworkManager.ConnectEvent("MoveItem", NetworkManager.HandleMoveItem)
	NetworkManager.ConnectEvent("EquipItem", NetworkManager.HandleEquipItem)
	NetworkManager.ConnectEvent("UnequipItem", NetworkManager.HandleUnequipItem)
	
	-- Aquarium Management
	NetworkManager.ConnectEvent("PlaceDecoration", NetworkManager.HandlePlaceDecoration)
	NetworkManager.ConnectEvent("RemoveDecoration", NetworkManager.HandleRemoveDecoration)
	NetworkManager.ConnectEvent("ChangeBackground", NetworkManager.HandleChangeBackground)
	
	-- Daily Systems
	NetworkManager.ConnectEvent("ClaimDailyReward", NetworkManager.HandleClaimDailyReward)
	NetworkManager.ConnectEvent("ClaimWeeklyReward", NetworkManager.HandleClaimWeeklyReward)
	
	-- Save Systems
	NetworkManager.ConnectEvent("SaveGameData", NetworkManager.HandleSaveGameData)
	NetworkManager.ConnectEvent("LoadGameData", NetworkManager.HandleLoadGameData)
	
	-- Remote Functions
	NetworkManager.ConnectFunction("GetPlayerData", NetworkManager.HandleGetPlayerData)
	NetworkManager.ConnectFunction("GetInventory", NetworkManager.HandleGetInventory)
	NetworkManager.ConnectFunction("GetAquariumData", NetworkManager.HandleGetAquariumData)
	NetworkManager.ConnectFunction("GetShopItems", NetworkManager.HandleGetShopItems)
	NetworkManager.ConnectFunction("GetDailyRewards", NetworkManager.HandleGetDailyRewards)
	NetworkManager.ConnectFunction("CanAffordItem", NetworkManager.HandleCanAffordItem)
end

function NetworkManager.ConnectEvent(eventName, handler)
	local remote = remoteEvents[eventName]
	if remote then
		remote.OnServerEvent:Connect(handler)
	else
		GameUtilities.LogWarning("NetworkManager: RemoteEvent not found: " .. eventName)
	end
end

function NetworkManager.ConnectFunction(functionName, handler)
	local remote = remoteFunctions[functionName]
	if remote then
		remote.OnServerInvoke = handler
	else
		GameUtilities.LogWarning("NetworkManager: RemoteFunction not found: " .. functionName)
	end
end

-- EVENT HANDLERS - PLAYER ACTIONS
function NetworkManager.HandlePlayerSpawn(player, position, className)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " requested spawn at " .. tostring(position))
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if data then
		-- Apply class if specified
		if className and className ~= data.Class then
			PlayerDataManager.ApplyClassStats(player, className)
		end
		
		-- Spawn player (would integrate with character spawning system)
		NetworkManager.SendToClient(player, "UpdatePlayerStats", {
			Health = data.Health,
			MaxHealth = data.MaxHealth,
			Hunger = data.Hunger,
			MaxHunger = data.MaxHunger,
			Speed = data.Speed,
			Class = data.Class,
			Level = data.Level,
			XP = data.XP,
			Gold = data.Gold,
			Crystals = data.Crystals
		})
	end
end

function NetworkManager.HandlePlayerMove(player, position, direction)
	-- Validate movement (anti-cheat)
	local character = player.Character
	if not character or not character.PrimaryPart then return end
	
	local currentPosition = character.PrimaryPart.Position
	local distance = (position - currentPosition).Magnitude
	
	-- Basic movement validation (max speed check)
	if distance > 100 then -- Too far, likely cheating
		GameUtilities.LogWarning("NetworkManager: " .. player.Name .. " attempted invalid movement")
		return
	end
	
	-- Update other clients about movement
	NetworkManager.SendToAllClients("PlayerMove", {
		PlayerId = player.UserId,
		Position = position,
		Direction = direction
	}, player)
end

function NetworkManager.HandlePlayerAttack(player, targetPosition, attackType)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " performed " .. attackType .. " attack")
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	-- Check attack cooldown
	local classData = require(script.Parent.Parent.Parent.Shared.Data.GameData).SharkClasses[data.Class]
	if not classData then return end
	
	local abilityData = classData.Abilities[attackType]
	if not abilityData then return end
	
	local cooldownKey = attackType .. "_Cooldown"
	local lastAttack = data.AbilityCooldowns[cooldownKey] or 0
	local currentTime = tick()
	
	if currentTime - lastAttack < abilityData.Cooldown then
		return -- Still on cooldown
	end
	
	-- Update cooldown
	data.AbilityCooldowns[cooldownKey] = currentTime
	
	-- Calculate damage
	local damage = abilityData.Damage or 0
	local classMultiplier = GameConstants.CLASS_STATS[data.Class].DamageMultiplier or 1
	damage = damage * classMultiplier
	
	-- Find targets in range
	local attackRange = abilityData.Range or 10
	local targets = NetworkManager.FindTargetsInRange(player, targetPosition, attackRange)
	
	-- Deal damage to targets
	local GameLoopManager = require(script.Parent.GameLoopManager)
	for _, target in pairs(targets) do
		if target:IsA("Player") then
			PlayerDataManager.DamagePlayer(target, damage, GameEnums.DamageType.PHYSICAL)
		elseif target:IsA("Model") then
			-- Handle enemy damage
			GameLoopManager.DamageEnemy(target, damage)
		end
	end
	
	-- Notify clients
	NetworkManager.SendToAllClients("PlayerAttack", {
		PlayerId = player.UserId,
		AttackType = attackType,
		Position = targetPosition,
		Targets = NetworkManager.GetTargetIds(targets)
	})
	
	-- Update statistics
	data.Statistics.TotalDamageDealt += damage
	data.Statistics.TotalAbilitiesUsed += 1
end

function NetworkManager.HandlePlayerBoost(player, direction)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " activated boost")
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	-- Check boost cooldown
	local lastBoost = data.AbilityCooldowns["Boost_Cooldown"] or 0
	local currentTime = tick()
	
	if currentTime - lastBoost < GameConstants.SHARK_BOOST_COOLDOWN then
		return -- Still on cooldown
	end
	
	-- Apply boost
	data.AbilityCooldowns["Boost_Cooldown"] = currentTime
	
	-- Notify clients
	NetworkManager.SendToAllClients("PlayerBoost", {
		PlayerId = player.UserId,
		Direction = direction
	})
	
	-- Update statistics
	data.Statistics.TotalBoostsUsed += 1
end

function NetworkManager.HandlePlayerInteract(player, interactableType, interactableId)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " interacted with " .. interactableType)
	
	-- Handle different interaction types
	if interactableType == "Food" then
		NetworkManager.HandleFoodPickup(player, interactableId)
	elseif interactableType == "Decoration" then
		NetworkManager.HandleDecorationInteraction(player, interactableId)
	elseif interactableType == "NPC" then
		NetworkManager.HandleNPCInteraction(player, interactableId)
	end
end

-- EVENT HANDLERS - GAME SYSTEMS
function NetworkManager.HandleFeedShark(player, foodType)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " fed shark with " .. foodType)
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	-- Check if player has food
	local foodItem = nil
	for _, item in pairs(data.Inventory) do
		if item.Name == foodType and item.Type == GameEnums.ItemType.FOOD then
			foodItem = item
			break
		end
	end
	
	if not foodItem then
		NetworkManager.SendToClient(player, "Error", "You don't have this food")
		return
	end
	
	-- Remove food from inventory
	if PlayerDataManager.RemoveItem(player, foodItem.Id, 1) then
		-- Feed shark
		local foodData = GameData.Items[foodType]
		if foodData then
			PlayerDataManager.FeedShark(player, foodData.HungerRestore or 20)
			
			-- Heal if food provides healing
			if foodData.HealthRestore and foodData.HealthRestore > 0 then
				PlayerDataManager.HealPlayer(player, foodData.HealthRestore)
			end
		end
		
		-- Notify client
		NetworkManager.SendToClient(player, "UpdateHunger", data.Hunger)
		NetworkManager.SendToClient(player, "Success", "Shark fed successfully!")
	end
end

function NetworkManager.HandleCleanAquarium(player)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " cleaned aquarium")
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	-- Check cooldown
	local currentTime = GameUtilities.GetTimestamp()
	if currentTime - data.LastCleanedTime < GameConstants.AQUARIUM_CLEANUP_COOLDOWN then
		local remainingTime = GameConstants.AQUARIUM_CLEANUP_COOLDOWN - (currentTime - data.LastCleanedTime)
		NetworkManager.SendToClient(player, "Error", "Please wait " .. math.ceil(remainingTime) .. " seconds")
		return
	end
	
	-- Clean aquarium
	data.LastCleanedTime = currentTime
	data.SharkEmotion = GameEnums.EmotionState.HAPPY
	
	-- Award small amount of XP
	PlayerDataManager.AddXP(player, 5)
	
	-- Notify client
	NetworkManager.SendToClient(player, "AquariumStateChanged", {
		Emotion = data.SharkEmotion,
		LastCleanedTime = data.LastCleanedTime
	})
	NetworkManager.SendToClient(player, "Success", "Aquarium cleaned successfully!")
end

function NetworkManager.HandleApplyMutation(player, mutationType)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " applied mutation " .. mutationType)
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	
	-- Apply mutation
	local success = PlayerDataManager.ApplyMutation(player, mutationType)
	
	if success then
		NetworkManager.SendToClient(player, "MutationApplied", {
			Type = mutationType,
			Duration = GameConstants.MUTATION_DURATION
		})
		NetworkManager.SendToClient(player, "Success", "Mutation applied successfully!")
	else
		NetworkManager.SendToClient(player, "Error", "Cannot apply this mutation")
	end
end

function NetworkManager.HandleChangeClass(player, newClass)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " changed class to " .. newClass)
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	if data.Class == newClass then
		NetworkManager.SendToClient(player, "Error", "You already have this class")
		return
	end
	
	-- Check if player can afford class change
	local classChangeCost = 100 -- Gold cost
	if not PlayerDataManager.CanAfford(player, GameEnums.CurrencyType.GOLD, classChangeCost) then
		NetworkManager.SendToClient(player, "Error", "Not enough gold to change class")
		return
	end
	
	-- Change class
	PlayerDataManager.SpendCurrency(player, GameEnums.CurrencyType.GOLD, classChangeCost)
	PlayerDataManager.ApplyClassStats(player, newClass)
	
	-- Notify client
	NetworkManager.SendToClient(player, "ClassChanged", {
		NewClass = newClass,
		Stats = {
			Health = data.Health,
			MaxHealth = data.MaxHealth,
			Speed = data.Speed
		}
	})
	NetworkManager.SendToClient(player, "Success", "Class changed successfully!")
end

function NetworkManager.HandleUseItem(player, itemId)
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " used item " .. itemId)
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	-- Find item in inventory
	local item = nil
	for _, invItem in pairs(data.Inventory) do
		if invItem.Id == itemId then
			item = invItem
			break
		end
	end
	
	if not item then
		NetworkManager.SendToClient(player, "Error", "Item not found")
		return
	end
	
	-- Use item based on type
	if item.Type == GameEnums.ItemType.POTION then
		-- Apply potion effect
		if item.Effect == "Heal" then
			PlayerDataManager.HealPlayer(player, item.Value or 50)
		elseif item.Effect == "SpeedBoost" then
			-- Apply speed boost (would need temporary effect system)
			data.Speed = data.Speed * (item.Value or 1.5)
		end
		
		-- Remove item
		PlayerDataManager.RemoveItem(player, itemId, 1)
		
		NetworkManager.SendToClient(player, "Success", "Item used successfully!")
	else
		NetworkManager.SendToClient(player, "Error", "This item cannot be used")
	end
end

function NetworkManager.HandleBuyItem(player, itemId, quantity)
	quantity = quantity or 1
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " bought " .. quantity .. "x " .. itemId)
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	local itemData = GameData.Items[itemId]
	if not itemData then
		NetworkManager.SendToClient(player, "Error", "Item not found")
		return
	end
	
	local totalCost = itemData.Cost * quantity
	
	-- Check if player can afford
	if not PlayerDataManager.CanAfford(player, GameEnums.CurrencyType.GOLD, totalCost) then
		NetworkManager.SendToClient(player, "Error", "Not enough gold")
		return
	end
	
	-- Check inventory space
	if #data.Inventory >= GameConstants.INVENTORY_SLOTS then
		NetworkManager.SendToClient(player, "Error", "Inventory full")
		return
	end
	
	-- Purchase item
	PlayerDataManager.SpendCurrency(player, GameEnums.CurrencyType.GOLD, totalCost)
	PlayerDataManager.AddItem(player, itemData, quantity)
	
	-- Notify client
	NetworkManager.SendToClient(player, "UpdateGold", data.Gold)
	NetworkManager.SendToClient(player, "Success", "Item purchased successfully!")
end

function NetworkManager.HandleSellItem(player, itemId, quantity)
	quantity = quantity or 1
	GameUtilities.DebugPrint("NetworkManager: " .. player.Name .. " sold " .. quantity .. "x " .. itemId)
	
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return end
	
	-- Find item in inventory
	local item = nil
	for _, invItem in pairs(data.Inventory) do
		if invItem.Id == itemId then
			item = invItem
			break
		end
	end
	
	if not item then
		NetworkManager.SendToClient(player, "Error", "Item not found")
		return
	end
	
	local itemData = GameData.Items[item.Name]
	if not itemData then
		NetworkManager.SendToClient(player, "Error", "Item data not found")
		return
	end
	
	-- Calculate sell price (50% of buy price)
	local sellPrice = math.floor((itemData.Cost or 0) * 0.5) * quantity
	
	-- Remove item and give gold
	if PlayerDataManager.RemoveItem(player, itemId, quantity) then
		PlayerDataManager.AddCurrency(player, GameEnums.CurrencyType.GOLD, sellPrice)
		
		-- Notify client
		NetworkManager.SendToClient(player, "UpdateGold", data.Gold)
		NetworkManager.SendToClient(player, "Success", "Item sold for " .. sellPrice .. " gold!")
	end
end

-- UTILITY FUNCTIONS
function NetworkManager.FindTargetsInRange(player, centerPosition, range)
	local targets = {}
	
	-- Check enemy targets
	local GameLoopManager = require(script.Parent.GameLoopManager)
	for _, enemy in pairs(GameLoopManager.GetEnemies()) do
		if enemy.Model and enemy.Model.PrimaryPart then
			local distance = (enemy.Model.PrimaryPart.Position - centerPosition).Magnitude
			if distance <= range then
				table.insert(targets, enemy.Model)
			end
		end
	end
	
	-- Check player targets (for PvP if enabled)
	for _, otherPlayer in pairs(game.Players:GetPlayers()) do
		if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character.PrimaryPart then
			local distance = (otherPlayer.Character.PrimaryPart.Position - centerPosition).Magnitude
			if distance <= range then
				table.insert(targets, otherPlayer)
			end
		end
	end
	
	return targets
end

function NetworkManager.GetTargetIds(targets)
	local ids = {}
	for _, target in pairs(targets) do
		if target:IsA("Player") then
			table.insert(ids, "Player_" .. target.UserId)
		elseif target:IsA("Model") then
			table.insert(ids, "Model_" .. target:GetFullName())
		end
	end
	return ids
end

-- MESSAGE SENDING
function NetworkManager.SendToClient(player, eventName, data)
	local remote = remoteEvents[eventName]
	if remote then
		remote:FireClient(player, data)
	else
		GameUtilities.LogWarning("NetworkManager: RemoteEvent not found: " .. eventName)
	end
end

function NetworkManager.SendToAllClients(eventName, data, excludePlayer)
	local remote = remoteEvents[eventName]
	if remote then
		for _, player in pairs(game.Players:GetPlayers()) do
			if player ~= excludePlayer then
				remote:FireClient(player, data)
			end
		end
	else
		GameUtilities.LogWarning("NetworkManager: RemoteEvent not found: " .. eventName)
	end
end

-- REMOTE FUNCTION HANDLERS
function NetworkManager.HandleGetPlayerData(player)
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	return PlayerDataManager.GetPlayerData(player.UserId)
end

function NetworkManager.HandleGetInventory(player)
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	return data and data.Inventory or {}
end

function NetworkManager.HandleGetAquariumData(player)
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return {} end
	
	return {
		Decorations = data.AquariumDecorations,
		Background = data.AquariumBackground,
		SharkEmotion = data.SharkEmotion,
		LastFedTime = data.LastFedTime,
		LastCleanedTime = data.LastCleanedTime
	}
end

function NetworkManager.HandleGetShopItems(player)
	local shopItems = {}
	
	for itemName, itemData in pairs(GameData.Items) do
		if itemData.Type == GameEnums.ItemType.POTION or itemData.Type == GameEnums.ItemType.FOOD then
			table.insert(shopItems, {
				Id = itemName,
				Name = itemData.DisplayName,
				Type = itemData.Type,
				Cost = itemData.Cost,
				Description = itemData.Description,
				Rarity = itemData.Rarity
			})
		end
	end
	
	return shopItems
end

function NetworkManager.HandleGetDailyRewards(player)
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return {} end
	
	local currentTime = GameUtilities.GetTimestamp()
	local canClaimDaily = not GameUtilities.IsSameDay(currentTime, data.LastDailyReward)
	local canClaimWeekly = (currentTime - data.LastWeeklyReward) >= (7 * 24 * 60 * 60)
	
	return {
		CanClaimDaily = canClaimDaily,
		CanClaimWeekly = canClaimWeekly,
		DailyStreak = data.DailyRewardStreak,
		LastDailyReward = data.LastDailyReward,
		LastWeeklyReward = data.LastWeeklyReward
	}
end

function NetworkManager.HandleCanAffordItem(player, itemId, quantity)
	local PlayerDataManager = require(script.Parent.PlayerDataManager)
	local data = PlayerDataManager.GetPlayerData(player.UserId)
	
	if not data then return false end
	
	local itemData = GameData.Items[itemId]
	if not itemData then return false end
	
	local totalCost = itemData.Cost * (quantity or 1)
	return PlayerDataManager.CanAfford(player, GameEnums.CurrencyType.GOLD, totalCost)
end

-- PLACEHOLDER HANDLERS (to be implemented)
function NetworkManager.HandleMoveItem(player, fromSlot, toSlot)
	-- TODO: Implement inventory item movement
end

function NetworkManager.HandleEquipItem(player, itemId)
	-- TODO: Implement item equipping
end

function NetworkManager.HandleUnequipItem(player, itemId)
	-- TODO: Implement item unequipping
end

function NetworkManager.HandlePlaceDecoration(player, decorationId, position)
	-- TODO: Implement decoration placement
end

function NetworkManager.HandleRemoveDecoration(player, decorationId)
	-- TODO: Implement decoration removal
end

function NetworkManager.HandleChangeBackground(player, backgroundId)
	-- TODO: Implement background changing
end

function NetworkManager.HandleClaimDailyReward(player)
	-- TODO: Implement daily reward claiming
end

function NetworkManager.HandleClaimWeeklyReward(player)
	-- TODO: Implement weekly reward claiming
end

function NetworkManager.HandleSaveGameData(player)
	-- TODO: Implement manual save
end

function NetworkManager.HandleLoadGameData(player)
	-- TODO: Implement manual load
end

function NetworkManager.HandleFoodPickup(player, foodId)
	-- TODO: Implement food pickup
end

function NetworkManager.HandleDecorationInteraction(player, decorationId)
	-- TODO: Implement decoration interaction
end

function NetworkManager.HandleNPCInteraction(player, npcId)
