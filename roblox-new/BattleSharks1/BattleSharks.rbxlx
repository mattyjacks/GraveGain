  <Item class="StarterPlayer" referent="21">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="22">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="23">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- BattleSharks Client Initialization
-- Main entry point for the client-side game systems

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

-- Import controllers
local SharkController = require(script.Controllers.SharkController)
local CameraController = require(script.Controllers.CameraController)

-- Client configuration
local CLIENT_CONFIG = {
	ENABLE_DEBUG = true,
	NETWORK_UPDATE_RATE = 20,
	CLIENT_VERSION = "0.1.0"
}

-- Initialize all client systems
local function InitializeClient()
	print("=== BattleSharks Client Starting ===")
	print("Version:", CLIENT_CONFIG.CLIENT_VERSION)
	print("Player:", Players.LocalPlayer.Name)
	
	-- Wait for game to load
	ReplicatedStorage:WaitForChild("BattleSharksRemotes")
	
	-- Initialize controllers
	SharkController.Initialize()
	CameraController.Initialize()
	
	-- Set up network event handlers
	SetupNetworkHandlers()
	
	-- Set up periodic tasks
	SetupPeriodicTasks()
	
	-- Hide default GUI
	SetupUserInterface()
	
	print("=== BattleSharks Client Ready ===")
end

-- Set up network event handlers
local function SetupNetworkHandlers()
	local remoteFolder = ReplicatedStorage:WaitForChild("BattleSharksRemotes")
	
	-- Player stat updates
	local updateStatsEvent = remoteFolder:WaitForChild("UpdatePlayerStats")
	updateStatsEvent.OnClientEvent:Connect(OnPlayerStatsUpdated)
	
	-- Hunger updates
	local hungerEvent = remoteFolder:WaitForChild("UpdateHunger")
	hungerEvent.OnClientEvent:Connect(OnHungerUpdated)
	
	-- Health updates
	local healthEvent = remoteFolder:WaitForChild("UpdateHealth")
	healthEvent.OnClientEvent:Connect(OnHealthUpdated)
	
	-- XP updates
	local xpEvent = remoteFolder:WaitForChild("UpdateXP")
	xpEvent.OnClientEvent:Connect(OnXPUpdated)
	
	-- Level updates
	local levelEvent = remoteFolder:WaitForChild("UpdateLevel")
	levelEvent.OnClientEvent:Connect(OnLevelUpdated)
	
	-- Currency updates
	local goldEvent = remoteFolder:WaitForChild("UpdateGold")
	goldEvent.OnClientEvent:Connect(OnGoldUpdated)
	
	-- Ability cooldowns
	local cooldownEvent = remoteFolder:WaitForChild("AbilityCooldown")
	cooldownEvent.OnClientEvent:Connect(OnAbilityCooldown)
	
	-- Game messages
	local messageEvent = remoteFolder:WaitForChild("GameMessage")
	messageEvent.OnClientEvent:Connect(OnGameMessage)
	
	-- Error messages
	local errorEvent = remoteFolder:WaitForChild("Error")
	errorEvent.OnClientEvent:Connect(OnErrorMessage)
	
	-- Success messages
	local successEvent = remoteFolder:WaitForChild("Success")
	successEvent.OnClientEvent:Connect(OnSuccessMessage)
	
	print("Network handlers configured")
end

-- Set up periodic tasks
local function SetupPeriodicTasks()
	-- Network sync task
	task.spawn(function()
		while true do
			task.wait(1 / CLIENT_CONFIG.NETWORK_UPDATE_RATE)
			
			-- Send periodic updates to server
			SendPeriodicUpdates()
		end
	end)
	
	-- Performance monitoring
	task.spawn(function()
		while true do
			task.wait(60) -- Every minute
			
			local stats = {
				ClientMemory = collectgarbage("count"),
				FPS = math.floor(1 / RunService.Heartbeat:Wait()),
				Ping = GetPing()
			}
			
			print(string.format("Client Stats - Memory: %.2f MB, FPS: %d, Ping: %d ms", 
				stats.ClientMemory / 1024, stats.FPS, stats.Ping))
		end
	end)
	
	print("Periodic tasks configured")
end

-- Set up user interface
local function SetupUserInterface()
	-- Hide default Roblox GUI
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.All, false)
	
	-- Create custom HUD (placeholder)
	CreateBasicHUD()
end

function CreateBasicHUD()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	
	-- Create main HUD frame
	local hudFrame = Instance.new("ScreenGui")
	hudFrame.Name = "BattleSharksHUD"
	hudFrame.ResetOnSpawn = false
	hudFrame.Parent = playerGui
	
	-- Health bar
	local healthFrame = Instance.new("Frame")
	healthFrame.Name = "HealthFrame"
	healthFrame.Size = UDim2.new(0, 200, 0, 20)
	healthFrame.Position = UDim2.new(0, 10, 0, 10)
	healthFrame.BackgroundColor3 = Color3.new(0, 0, 0)
	healthFrame.BorderSizePixel = 2
	healthFrame.BorderColor3 = Color3.new(1, 1, 1)
	healthFrame.Parent = hudFrame
	
	local healthBar = Instance.new("Frame")
	healthBar.Name = "HealthBar"
	healthBar.Size = UDim2.new(1, 0, 1, 0)
	healthBar.Position = UDim2.new(0, 0, 0, 0)
	healthBar.BackgroundColor3 = Color3.new(1, 0, 0)
	healthBar.Parent = healthFrame
	
	local healthText = Instance.new("TextLabel")
	healthText.Name = "HealthText"
	healthText.Size = UDim2.new(1, 0, 1, 0)
	healthText.BackgroundTransparency = 1
	healthText.Text = "100/100"
	healthText.TextColor3 = Color3.new(1, 1, 1)
	healthText.TextScaled = true
	healthText.Font = Enum.Font.SourceSansBold
	healthText.Parent = healthFrame
	
	-- Hunger bar
	local hungerFrame = Instance.new("Frame")
	hungerFrame.Name = "HungerFrame"
	hungerFrame.Size = UDim2.new(0, 200, 0, 20)
	hungerFrame.Position = UDim2.new(0, 10, 0, 40)
	hungerFrame.BackgroundColor3 = Color3.new(0, 0, 0)
	hungerFrame.BorderSizePixel = 2
	hungerFrame.BorderColor3 = Color3.new(1, 1, 1)
	hungerFrame.Parent = hudFrame
	
	local hungerBar = Instance.new("Frame")
	hungerBar.Name = "HungerBar"
	hungerBar.Size = UDim2.new(1, 0, 1, 0)
	hungerBar.Position = UDim2.new(0, 0, 0, 0)
	hungerBar.BackgroundColor3 = Color3.new(1, 0.5, 0)
	hungerBar.Parent = hungerFrame
	
	local hungerText = Instance.new("TextLabel")
	hungerText.Name = "HungerText"
	hungerText.Size = UDim2.new(1, 0, 1, 0)
	hungerText.BackgroundTransparency = 1
	hungerText.Text = "100/100"
	hungerText.TextColor3 = Color3.new(1, 1, 1)
	hungerText.TextScaled = true
	hungerText.Font = Enum.Font.SourceSansBold
	hungerText.Parent = hungerFrame
	
	-- Level and XP
	local levelFrame = Instance.new("Frame")
	levelFrame.Name = "LevelFrame"
	levelFrame.Size = UDim2.new(0, 200, 0, 40)
	levelFrame.Position = UDim2.new(0, 10, 0, 70)
	levelFrame.BackgroundColor3 = Color3.new(0, 0, 0)
	levelFrame.BorderSizePixel = 2
	levelFrame.BorderColor3 = Color3.new(1, 1, 1)
	levelFrame.Parent = hudFrame
	
	local levelText = Instance.new("TextLabel")
	levelText.Name = "LevelText"
	levelText.Size = UDim2.new(1, 0, 0, 20)
	levelText.Position = UDim2.new(0, 0, 0, 0)
	levelText.BackgroundTransparency = 1
	levelText.Text = "Level 1"
	levelText.TextColor3 = Color3.new(1, 1, 1)
	levelText.TextScaled = true
	levelText.Font = Enum.Font.SourceSansBold
	levelText.Parent = levelFrame
	
	local xpBar = Instance.new("Frame")
	xpBar.Name = "XPBar"
	xpBar.Size = UDim2.new(0.8, 0, 0, 10)
	xpBar.Position = UDim2.new(0.1, 0, 0, 25)
	xpBar.BackgroundColor3 = Color3.new(0, 0.5, 1)
	xpBar.Parent = levelFrame
	
	-- Controls info
	local controlsFrame = Instance.new("Frame")
	controlsFrame.Name = "ControlsFrame"
	controlsFrame.Size = UDim2.new(0, 300, 0, 150)
	controlsFrame.Position = UDim2.new(1, -310, 0, 10)
	controlsFrame.BackgroundColor3 = Color3.new(0, 0, 0)
	controlsFrame.BorderSizePixel = 2
	controlsFrame.BorderColor3 = Color3.new(1, 1, 1)
	controlsFrame.Parent = hudFrame
	
	local controlsTitle = Instance.new("TextLabel")
	controlsTitle.Name = "Title"
	controlsTitle.Size = UDim2.new(1, 0, 0, 30)
	controlsTitle.Position = UDim2.new(0, 0, 0, 0)
	controlsTitle.BackgroundTransparency = 1
	controlsTitle.Text = "CONTROLS"
	controlsTitle.TextColor3 = Color3.new(1, 1, 1)
	controlsTitle.TextScaled = true
	controlsTitle.Font = Enum.Font.SourceSansBold
	controlsTitle.Parent = controlsFrame
	
	local controlsText = Instance.new("TextLabel")
	controlsText.Name = "Text"
	controlsText.Size = UDim2.new(1, -10, 1, -40)
	controlsText.Position = UDim2.new(0, 5, 0, 35)
	controlsText.BackgroundTransparency = 1
	controlsText.Text = "WASD - Move\nShift - Boost\nSpace - Leap\nE - Attack\nMouse Wheel - Zoom\nMiddle Mouse - Rotate Camera"
	controlsText.TextColor3 = Color3.new(1, 1, 1)
	controlsText.TextScaled = false
	controlsText.Font = Enum.Font.SourceSans
	controlsText.TextXAlignment = Enum.TextXAlignment.Left
	controlsText.TextYAlignment = Enum.TextYAlignment.Top
	controlsText.Parent = controlsFrame
end

-- NETWORK EVENT HANDLERS
function OnPlayerStatsUpdated(stats)
	print("Player stats updated:", stats)
	
	-- Update HUD
	UpdateHUD(stats)
end

function OnHungerUpdated(hunger)
	print("Hunger updated:", hunger)
	
	local hudFrame = Players.LocalPlayer.PlayerGui:FindFirstChild("BattleSharksHUD")
	if hudFrame then
		local hungerFrame = hudFrame:FindFirstChild("HungerFrame")
		if hungerFrame then
			local hungerBar = hungerFrame:FindFirstChild("HungerBar")
			local hungerText = hungerFrame:FindFirstChild("HungerText")
			
			if hungerBar then
				hungerBar.Size = UDim2.new(hunger / 100, 0, 1, 0)
			end
			if hungerText then
				hungerText.Text = math.floor(hunger) .. "/100"
			end
		end
	end
end

function OnHealthUpdated(health)
	print("Health updated:", health)
	
	local hudFrame = Players.LocalPlayer.PlayerGui:FindFirstChild("BattleSharksHUD")
	if hudFrame then
		local healthFrame = hudFrame:FindFirstChild("HealthFrame")
		if healthFrame then
			local healthBar = healthFrame:FindFirstChild("HealthBar")
			local healthText = healthFrame:FindFirstChild("HealthText")
			
			if healthBar then
				healthBar.Size = UDim2.new(health / 100, 0, 1, 0)
			end
			if healthText then
				healthText.Text = math.floor(health) .. "/100"
			end
		end
	end
end

function OnXPUpdated(xp)
	print("XP updated:", xp)
end

function OnLevelUpdated(level)
	print("Level updated:", level)
	
	local hudFrame = Players.LocalPlayer.PlayerGui:FindFirstChild("BattleSharksHUD")
	if hudFrame then
		local levelFrame = hudFrame:FindFirstChild("LevelFrame")
		if levelFrame then
			local levelText = levelFrame:FindFirstChild("LevelText")
			if levelText then
				levelText.Text = "Level " .. level
			end
		end
	end
end

function OnGoldUpdated(gold)
	print("Gold updated:", gold)
end

function OnAbilityCooldown(abilityName, cooldown)
	print("Ability cooldown:", abilityName, cooldown)
end

function OnGameMessage(message)
	print("Game message:", message)
	StarterGui:SetCore("ChatMakeSystemMessage", {
		Text = "[BattleSharks] " .. message,
		Color = Color3.new(1, 1, 1),
		Font = Enum.Font.SourceSansBold
	})
end

function OnErrorMessage(error)
	print("Error:", error)
	StarterGui:SetCore("ChatMakeSystemMessage", {
		Text = "[ERROR] " .. error,
		Color = Color3.new(1, 0, 0),
		Font = Enum.Font.SourceSansBold
	})
end

function OnSuccessMessage(message)
	print("Success:", message)
	StarterGui:SetCore("ChatMakeSystemMessage", {
		Text = "[SUCCESS] " .. message,
		Color = Color3.new(0, 1, 0),
		Font = Enum.Font.SourceSansBold
	})
end

-- UTILITY FUNCTIONS
function UpdateHUD(stats)
	-- Update HUD elements with new stats
	if stats.Health then
		OnHealthUpdated(stats.Health)
	end
	if stats.Hunger then
		OnHungerUpdated(stats.Hunger)
	end
	if stats.Level then
		OnLevelUpdated(stats.Level)
	end
	if stats.Gold then
		OnGoldUpdated(stats.Gold)
	end
end

function SendPeriodicUpdates()
	-- Send periodic updates to server
	local remoteFolder = ReplicatedStorage:FindFirstChild("BattleSharksRemotes")
	if not remoteFolder then return end
	
	-- Example: Send position updates (handled by SharkController)
end

function GetPing()
	-- Simple ping calculation
	local startTime = tick()
	local remoteFolder = ReplicatedStorage:FindFirstChild("BattleSharksRemotes")
	if remoteFolder then
		local pingFunction = remoteFolder:FindFirstChild("PingClient")
		if pingFunction then
			pingFunction:InvokeServer()
			return math.floor((tick() - startTime) * 1000)
		end
	end
	return 0
end

-- Start the client
InitializeClient()
]]></string>
        </Properties>
        <Item class="Folder" referent="24">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="25">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[-- BattleSharks Camera Controller
-- Handles camera behavior for underwater and surface gameplay

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local GameConstants = require(script.Parent.Parent.Parent.Shared.Constants.GameConstants)
local GameUtilities = require(script.Parent.Parent.Parent.Shared.Utilities.GameUtilities)

local CameraController = {}

-- PRIVATE VARIABLES
local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera
local character = nil
local humanoidRootPart = nil

-- Camera settings
local cameraConfig = {
	DefaultDistance = 15,
	MinDistance = 5,
	MaxDistance = 50,
	HeightOffset = 2,
	AngleX = 15, -- Tilt angle
	AngleY = 0,  -- Rotation angle
	SmoothSpeed = 8,
	ZoomSpeed = 2,
	RotationSpeed = 0.5,
	UnderwaterFog = {Start = 10, End = 50, Color = Color3.new(0, 0.2, 0.4)},
	SurfaceFog = {Start = 100, End = 500, Color = Color3.new(0.8, 0.9, 1)}
}

-- Camera state
local cameraState = {
	CurrentDistance = cameraConfig.DefaultDistance,
	TargetDistance = cameraConfig.DefaultDistance,
	CurrentAngleX = cameraConfig.AngleX,
	TargetAngleX = cameraConfig.AngleX,
	CurrentAngleY = cameraConfig.AngleY,
	TargetAngleY = cameraConfig.AngleY,
	IsUnderwater = false,
	IsDragging = false,
	LastMousePosition = Vector2.zero,
	CameraShake = Vector3.zero,
	ShakeDecay = 0.9
}

-- INITIALIZATION
function CameraController.Initialize()
	GameUtilities.DebugPrint("CameraController: Initializing")
	
	-- Set up character events
	player.CharacterAdded:Connect(CameraController.OnCharacterAdded)
	player.CharacterRemoving:Connect(CameraController.OnCharacterRemoving)
	
	-- Set up input events
	UserInputService.InputBegan:Connect(CameraController.OnInputBegan)
	UserInputService.InputEnded:Connect(CameraController.OnInputEnded)
	UserInputService.InputChanged:Connect(CameraController.OnInputChanged)
	
	-- Initialize camera
	CameraController.SetupCamera()
	
	-- Start update loop
	CameraController.StartUpdateLoop()
	
	-- Initialize character if already loaded
	if player.Character then
		CameraController.OnCharacterAdded(player.Character)
	end
	
	GameUtilities.DebugPrint("CameraController: Initialized")
end

function CameraController.SetupCamera()
	-- Configure camera properties
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = 70
	camera.HeadScale = 1
	
	-- Set initial position
	CameraController.UpdateCameraPosition()
end

-- CHARACTER EVENTS
function CameraController.OnCharacterAdded(newCharacter)
	character = newCharacter
	humanoidRootPart = character:WaitForChild("HumanoidRootPart")
	
	GameUtilities.DebugPrint("CameraController: Character loaded")
end

function CameraController.OnCharacterRemoving(oldCharacter)
	character = nil
	humanoidRootPart = nil
	
	GameUtilities.DebugPrint("CameraController: Character removed")
end

-- INPUT HANDLING
function CameraController.OnInputBegan(input, gameProcessed)
	if gameProcessed then return end
	
	local inputType = input.UserInputType
	local keyCode = input.KeyCode
	
	-- Mouse wheel for zoom
	if inputType == Enum.UserInputType.MouseWheel then
		local scrollDelta = input.Position.Z
		CameraController.HandleZoom(scrollDelta)
	end
	
	-- Middle mouse for rotation
	if inputType == Enum.UserInputType.MouseButton2 then
		cameraState.IsDragging = true
		cameraState.LastMousePosition = input.Position
		UserInputService.MouseIconEnabled = false
	end
	
	-- Keyboard controls
	if keyCode == Enum.KeyCode.PageUp then
		CameraController.HandleZoom(1)
	elseif keyCode == Enum.KeyCode.PageDown then
		CameraController.HandleZoom(-1)
	end
end

function CameraController.OnInputEnded(input, gameProcessed)
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		cameraState.IsDragging = false
		UserInputService.MouseIconEnabled = true
	end
end

function CameraController.OnInputChanged(input, gameProcessed)
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseMovement and cameraState.IsDragging then
		local mouseDelta = input.Position - cameraState.LastMousePosition
		CameraController.HandleRotation(mouseDelta)
		cameraState.LastMousePosition = input.Position
	end
end

-- CAMERA CONTROLS
function CameraController.HandleZoom(scrollDelta)
	local zoomAmount = scrollDelta * cameraConfig.ZoomSpeed
	cameraState.TargetDistance = GameUtilities.Clamp(
		cameraState.TargetDistance - zoomAmount,
		cameraConfig.MinDistance,
		cameraConfig.MaxDistance
	)
end

function CameraController.HandleRotation(mouseDelta)
	-- Horizontal rotation (Y axis)
	cameraState.TargetAngleY += mouseDelta.X * cameraConfig.RotationSpeed
	
	-- Vertical rotation (X axis) with clamping
	cameraState.TargetAngleX -= mouseDelta.Y * cameraConfig.RotationSpeed
	cameraState.TargetAngleX = GameUtilities.Clamp(
		cameraState.TargetAngleX,
		-60, -- Minimum tilt
		80   -- Maximum tilt
	)
end

-- CAMERA UPDATES
function CameraController.StartUpdateLoop()
	RunService.Heartbeat:Connect(function(deltaTime)
		CameraController.UpdateCamera(deltaTime)
		CameraController.UpdateEnvironment()
	end)
end

function CameraController.UpdateCamera(deltaTime)
	if not humanoidRootPart then return end
	
	-- Smooth distance transition
	cameraState.CurrentDistance = GameUtilities.Lerp(
		cameraState.CurrentDistance,
		cameraState.TargetDistance,
		cameraConfig.SmoothSpeed * deltaTime
	)
	
	-- Smooth angle transitions
	cameraState.CurrentAngleX = GameUtilities.Lerp(
		cameraState.CurrentAngleX,
		cameraState.TargetAngleX,
		cameraConfig.SmoothSpeed * deltaTime
	)
	
	cameraState.CurrentAngleY = GameUtilities.Lerp(
		cameraState.CurrentAngleY,
		cameraState.TargetAngleY,
		cameraConfig.SmoothSpeed * deltaTime
	)
	
	-- Update camera position
	CameraController.UpdateCameraPosition()
	
	-- Update camera shake
	CameraController.UpdateCameraShake()
end

function CameraController.UpdateCameraPosition()
	if not humanoidRootPart then return end
	
	local characterPosition = humanoidRootPart.Position
	
	-- Calculate camera offset based on angles and distance
	local angleXRad = math.rad(cameraState.CurrentAngleX)
	local angleYRad = math.rad(cameraState.CurrentAngleY)
	
	local offsetX = math.sin(angleYRad) * math.cos(angleXRad) * cameraState.CurrentDistance
	local offsetY = math.sin(angleXRad) * cameraState.CurrentDistance + cameraConfig.HeightOffset
	local offsetZ = math.cos(angleYRad) * math.cos(angleXRad) * cameraState.CurrentDistance
	
	local cameraPosition = characterPosition + Vector3.new(offsetX, offsetY, offsetZ)
	
	-- Apply camera shake
	cameraPosition += cameraState.CameraShake
	
	-- Update camera CFrame
	camera.CFrame = CFrame.new(cameraPosition, characterPosition + Vector3.new(0, cameraConfig.HeightOffset, 0))
end

function CameraController.UpdateCameraShake()
	-- Apply shake decay
	cameraState.CameraShake *= cameraState.ShakeDecay
	
	-- Stop shake when very small
	if cameraState.CameraShake.Magnitude < 0.01 then
		cameraState.CameraShake = Vector3.zero
	end
end

function CameraController.UpdateEnvironment()
	if not humanoidRootPart then return end
	
	local currentY = humanoidRootPart.Position.Y
	local wasUnderwater = cameraState.IsUnderwater
	cameraState.IsUnderwater = currentY <= GameConstants.WATER_LEVEL
	
	-- Update environment when crossing water surface
	if wasUnderwater ~= cameraState.IsUnderwater then
		CameraController.UpdateEnvironmentEffects()
	end
end

function CameraController.UpdateEnvironmentEffects()
	local Lighting = game:GetService("Lighting")
	
	if cameraState.IsUnderwater then
		-- Underwater effects
		Lighting.FogColor = cameraConfig.UnderwaterFog.Color
		Lighting.FogStart = cameraConfig.UnderwaterFog.Start
		Lighting.FogEnd = cameraConfig.UnderwaterFog.End
		
		-- Underwater lighting
		Lighting.Ambient = Color3.new(0, 0.1, 0.2)
		Lighting.Brightness = 0.8
		
		-- Underwater color correction
		camera.ColorCorrection = ColorCorrectionEffect.new()
		camera.ColorCorrection.TintColor = Color3.new(0.8, 0.9, 1)
		camera.ColorCorrection.Contrast = 0.1
		camera.ColorCorrection.Saturation = 0.8
		
		-- Underwater blur
		camera.Blur = BlurEffect.new()
		camera.Blur.Size = 2
		
	else
		-- Surface effects
		Lighting.FogColor = cameraConfig.SurfaceFog.Color
		Lighting.FogStart = cameraConfig.SurfaceFog.Start
		Lighting.FogEnd = cameraConfig.SurfaceFog.End
		
		-- Surface lighting
		Lighting.Ambient = Color3.new(0.2, 0.2, 0.2)
		Lighting.Brightness = 1.5
		
		-- Remove underwater effects
		if camera:FindFirstChild("ColorCorrection") then
			camera.ColorCorrection:Destroy()
		end
		if camera:FindFirstChild("Blur") then
			camera.Blur:Destroy()
		end
	end
end

-- CAMERA EFFECTS
function CameraController.AddCameraShake(intensity, duration)
	intensity = intensity or 5
	duration = duration or 0.5
	
	local shakeVector = Vector3.new(
		GameUtilities.RandomFloat(-intensity, intensity),
		GameUtilities.RandomFloat(-intensity, intensity),
		GameUtilities.RandomFloat(-intensity, intensity)
	)
	
	cameraState.CameraShake += shakeVector
	
	-- Auto-decay after duration
	task.delay(duration, function()
		cameraState.ShakeDecay = 0.9 -- Reset decay rate
	end)
end

function CameraController.SetCameraTarget(targetPosition, smoothTime)
	if not targetPosition then return end
	
	smoothTime = smoothTime or 1
	
	-- Create tween to target position
	local goalPosition = targetPosition + Vector3.new(0, cameraConfig.HeightOffset, 0)
	local goalCFrame = CFrame.new(
		goalPosition + Vector3.new(0, 0, cameraState.CurrentDistance),
		goalPosition
	)
	
	local tweenInfo = TweenInfo.new(smoothTime, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
	local tween = TweenService:Create(camera, tweenInfo, {CFrame = goalCFrame})
	
	tween:Play()
end

function CameraController.ResetCamera()
	cameraState.TargetDistance = cameraConfig.DefaultDistance
	cameraState.TargetAngleX = cameraConfig.AngleX
	cameraState.TargetAngleY = cameraConfig.AngleY
end

-- UTILITY FUNCTIONS
function CameraController.GetCameraState()
	return cameraState
end

function CameraController.IsUnderwater()
	return cameraState.IsUnderwater
end

function CameraController.GetDistance()
	return cameraState.CurrentDistance
end

function CameraController.SetDistance(distance)
	cameraState.TargetDistance = GameUtilities.Clamp(distance, cameraConfig.MinDistance, cameraConfig.MaxDistance)
end

function CameraController.GetAngles()
	return cameraState.CurrentAngleX, cameraState.CurrentAngleY
end

function CameraController.SetAngles(angleX, angleY)
	cameraState.TargetAngleX = GameUtilities.Clamp(angleX, -60, 80)
	cameraState.TargetAngleY = angleY
end

function CameraController.GetCameraDirection()
	if not humanoidRootPart then return Vector3.forward end
	
	local cameraDirection = (camera.CFrame.Position - humanoidRootPart.Position).Unit
	return cameraDirection
end

function CameraController.WorldToScreenPoint(worldPosition)
	return camera:WorldToScreenPoint(worldPosition)
end

function CameraController.ScreenToWorldPoint(screenPosition)
	return camera:ScreenToWorldPoint(screenPosition)
end

-- CLEANUP
function CameraController.Cleanup()
	-- Reset camera to default
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
	
	-- Remove effects
	if camera:FindFirstChild("ColorCorrection") then
		camera.ColorCorrection:Destroy()
	end
	if camera:FindFirstChild("Blur") then
		camera.Blur:Destroy()
	end
	
	-- Reset lighting
	local Lighting = game:GetService("Lighting")
	Lighting.FogColor = cameraConfig.SurfaceFog.Color
	Lighting.FogStart = cameraConfig.SurfaceFog.Start
	Lighting.FogEnd = cameraConfig.SurfaceFog.End
	Lighting.Ambient = Color3.new(0.2, 0.2, 0.2)
	Lighting.Brightness = 1.5
	
	-- Clear references
	character = nil
	humanoidRootPart = nil
	
	-- Reset state
	cameraState.CurrentDistance = cameraConfig.DefaultDistance
	cameraState.TargetDistance = cameraConfig.DefaultDistance
	cameraState.CurrentAngleX = cameraConfig.AngleX
	cameraState.TargetAngleX = cameraConfig.AngleX
	cameraState.CurrentAngleY = cameraConfig.AngleY
	cameraState.TargetAngleY = cameraConfig.AngleY
	cameraState.IsUnderwater = false
	cameraState.IsDragging = false
	cameraState.CameraShake = Vector3.zero
	
	GameUtilities.DebugPrint("CameraController: Cleaned up")
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="26">
            <Properties>
              <string name="Name">SharkController</string>
              <string name="Source"><![CDATA[-- BattleSharks Shark Controller
-- Handles player shark movement, abilities, and physics

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

local GameConstants = require(script.Parent.Parent.Parent.Shared.Constants.GameConstants)
local GameEnums = require(script.Parent.Parent.Parent.Shared.Enums.GameEnums)
local GameUtilities = require(script.Parent.Parent.Parent.Shared.Utilities.GameUtilities)

local SharkController = {}

-- PRIVATE VARIABLES
local player = Players.LocalPlayer
local character = nil
local humanoid = nil
local humanoidRootPart = nil

-- Movement state
local movementState = {
	IsMoving = false,
	IsBoosting = false,
	IsUnderwater = false,
	CurrentSpeed = 0,
	TargetVelocity = Vector3.zero,
	LastBoostTime = 0,
	BoostCooldown = 0
}

-- Input state
local inputState = {
	Forward = false,
	Backward = false,
	Left = false,
	Right = false,
	Boost = false,
	Attack = false,
	MousePosition = Vector2.zero
}

-- Physics parameters
local physics = {
	Gravity = Workspace.Gravity,
	WaterGravity = GameConstants.UNDERWATER_GRAVITY,
	WaterDensity = GameConstants.WATER_DENSITY,
	WaterLevel = GameConstants.WATER_LEVEL,
	BuoyancyForce = 50,
	DragCoefficient = 0.1,
	TurnSpeed = GameConstants.SHARK_TURN_SPEED
}

-- INITIALIZATION
function SharkController.Initialize()
	GameUtilities.DebugPrint("SharkController: Initializing")
	
	-- Set up character events
	player.CharacterAdded:Connect(SharkController.OnCharacterAdded)
	player.CharacterRemoving:Connect(SharkController.OnCharacterRemoving)
	
	-- Set up input events
	UserInputService.InputBegan:Connect(SharkController.OnInputBegan)
	UserInputService.InputEnded:Connect(SharkController.OnInputEnded)
	UserInputService.InputChanged:Connect(SharkController.OnInputChanged)
	
	-- Initialize character if already loaded
	if player.Character then
		SharkController.OnCharacterAdded(player.Character)
	end
	
	-- Start update loop
	SharkController.StartUpdateLoop()
	
	GameUtilities.DebugPrint("SharkController: Initialized")
end

-- CHARACTER EVENTS
function SharkController.OnCharacterAdded(newCharacter)
	character = newCharacter
	humanoid = character:WaitForChild("Humanoid")
	humanoidRootPart = character:WaitForChild("HumanoidRootPart")
	
	-- Configure humanoid for shark movement
	SharkController.ConfigureHumanoid()
	
	-- Set up physics
	SharkController.SetupPhysics()
	
	-- Apply initial stats
	SharkController.ApplyPlayerStats()
	
	GameUtilities.DebugPrint("SharkController: Character configured")
end

function SharkController.OnCharacterRemoving(oldCharacter)
	character = nil
	humanoid = nil
	humanoidRootPart = nil
	
	GameUtilities.DebugPrint("SharkController: Character removed")
end

function SharkController.ConfigureHumanoid()
	if not humanoid then return end
	
	-- Disable default Roblox movement
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Running, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
	
	-- Set movement properties
	humanoid.JumpPower = 0 -- Sharks don't jump normally
	humanoid.UseJumpPower = false
	
	-- Set state to swimming
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
	humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
end

function SharkController.SetupPhysics()
	if not humanoidRootPart then return end
	
	-- Configure body parts for water physics
	for _, part in pairs(character:GetDescendants()) do
		if part:IsA("BasePart") then
			-- Set material for water interaction
			part.Material = Enum.Material.Plastic
			part.CustomPhysicalProperties = PhysicalProperties.new(
				1.0, -- Density
				0.3, -- Friction
				0.5, -- Elasticity
				0.5, -- FrictionWeight
				0.5  -- ElasticityWeight
			)
		end
	end
end

function SharkController.ApplyPlayerStats()
	-- Request player data from server
	local NetworkManager = require(script.Parent.Parent.Parent.Shared.Networking.RemoteNames)
	local remoteFolder = ReplicatedStorage:WaitForChild("BattleSharksRemotes")
	
	local getStatsFunction = remoteFolder:WaitForChild("GetPlayerData")
	local playerData = getStatsFunction:InvokeServer()
	
	if playerData then
		movementState.CurrentSpeed = playerData.Speed or GameConstants.SHARK_BASE_SPEED
		
		-- Update humanoid health
		if humanoid then
			humanoid.MaxHealth = playerData.MaxHealth or 100
			humanoid.Health = playerData.Health or 100
		end
	end
end

-- INPUT HANDLING
function SharkController.OnInputBegan(input, gameProcessed)
	if gameProcessed then return end
	
	local inputType = input.UserInputType
	local keyCode = input.KeyCode
	
	-- Movement keys
	if keyCode == Enum.KeyCode.W then
		inputState.Forward = true
	elseif keyCode == Enum.KeyCode.S then
		inputState.Backward = true
	elseif keyCode == Enum.KeyCode.A then
		inputState.Left = true
	elseif keyCode == Enum.KeyCode.D then
		inputState.Right = true
	elseif keyCode == Enum.KeyCode.LeftShift then
		inputState.Boost = true
	elseif keyCode == Enum.KeyCode.Space then
		SharkController.PerformLeap()
	elseif keyCode == Enum.KeyCode.E then
		SharkController.PerformAttack()
	end
	
	-- Mouse input
	if inputType == Enum.UserInputType.MouseButton1 then
		inputState.Attack = true
		SharkController.PerformAttack()
	elseif inputType == Enum.UserInputType.MouseButton2 then
		SharkController.PerformSecondaryAction()
	end
end

function SharkController.OnInputEnded(input, gameProcessed)
	if gameProcessed then return end
	
	local keyCode = input.KeyCode
	
	if keyCode == Enum.KeyCode.W then
		inputState.Forward = false
	elseif keyCode == Enum.KeyCode.S then
		inputState.Backward = false
	elseif keyCode == Enum.KeyCode.A then
		inputState.Left = false
	elseif keyCode == Enum.KeyCode.D then
		inputState.Right = false
	elseif keyCode == Enum.KeyCode.LeftShift then
		inputState.Boost = false
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
		inputState.Attack = false
	end
end

function SharkController.OnInputChanged(input, gameProcessed)
	if gameProcessed then return end
	
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		inputState.MousePosition = input.Position
	end
end

-- MOVEMENT SYSTEM
function SharkController.StartUpdateLoop()
	RunService.Heartbeat:Connect(function(deltaTime)
		SharkController.UpdateMovement(deltaTime)
		SharkController.UpdatePhysics(deltaTime)
		SharkController.UpdateAnimation(deltaTime)
	end)
end

function SharkController.UpdateMovement(deltaTime)
	if not humanoidRootPart then return end
	
	-- Calculate movement direction
	local moveDirection = Vector3.zero
	
	if inputState.Forward then
		moveDirection += humanoidRootPart.CFrame.LookVector
	end
	if inputState.Backward then
		moveDirection -= humanoidRootPart.CFrame.LookVector
	end
	if inputState.Left then
		moveDirection -= humanoidRootPart.CFrame.RightVector
	end
	if inputState.Right then
		moveDirection += humanoidRootPart.CFrame.RightVector
	end
	
	-- Normalize movement direction
	if moveDirection.Magnitude > 0 then
		moveDirection = moveDirection.Unit
		movementState.IsMoving = true
	else
		movementState.IsMoving = false
	end
	
	-- Calculate target speed
	local targetSpeed = movementState.CurrentSpeed
	if inputState.Boost and SharkController.CanBoost() then
		targetSpeed = GameConstants.SHARK_BOOST_SPEED
		movementState.IsBoosting = true
	else
		movementState.IsBoosting = false
	end
	
	-- Apply boost cooldown
	if movementState.IsBoosting then
		movementState.LastBoostTime = tick()
		movementState.BoostCooldown = GameConstants.SHARK_BOOST_COOLDOWN
	end
	
	-- Update target velocity
	movementState.TargetVelocity = moveDirection * targetSpeed
	
	-- Apply movement
	if humanoid then
		humanoid:Move(movementState.TargetVelocity)
	end
	
	-- Check if underwater
	local currentY = humanoidRootPart.Position.Y
	movementState.IsUnderwater = currentY <= physics.WaterLevel
	
	-- Send movement to server
	if movementState.IsMoving then
		SharkController.SendMovementToServer()
	end
end

function SharkController.UpdatePhysics(deltaTime)
	if not humanoidRootPart then return end
	
	local currentY = humanoidRootPart.Position.Y
	
	-- Apply underwater physics
	if movementState.IsUnderwater then
		-- Apply buoyancy
		local buoyancy = Vector3.new(0, physics.BuoyancyForce * deltaTime, 0)
		humanoidRootPart:ApplyImpulse(buoyancy)
		
		-- Apply drag
		local velocity = humanoidRootPart.Velocity
		local drag = velocity * (-physics.DragCoefficient)
		humanoidRootPart:ApplyImpulse(drag * deltaTime)
		
		-- Reduce gravity effect
		Workspace.Gravity = physics.WaterGravity
	else
		-- Normal gravity
		Workspace.Gravity = physics.Gravity
	end
end

function SharkController.UpdateAnimation(deltaTime)
	if not humanoid then return end
	
	-- Update animation based on state
	if movementState.IsMoving then
		if movementState.IsBoosting then
			humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
		else
			humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
		end
	else
		humanoid:ChangeState(Enum.HumanoidStateType.Swimming)
	end
end

-- ABILITIES
function SharkController.CanBoost()
	local currentTime = tick()
	return currentTime - movementState.LastBoostTime >= movementState.BoostCooldown
end

function SharkController.PerformLeap()
	if not humanoidRootPart or not movementState.IsUnderwater then return end
	
	-- Only leap if near surface and moving upward
	local currentY = humanoidRootPart.Position.Y
	if currentY < physics.WaterLevel - 5 then return end
	
	-- Apply leap force
	local leapForce = Vector3.new(0, GameConstants.SHARK_LEAP_FORCE, 0)
	humanoidRootPart:ApplyImpulse(leapForce)
	
	-- Visual effect
	SharkController.CreateLeapEffect()
end

function SharkController.PerformAttack()
	if not humanoidRootPart then return end
	
	-- Calculate attack direction
	local camera = Workspace.CurrentCamera
	local lookDirection = camera.CFrame.LookVector
	local attackPosition = humanoidRootPart.Position + lookDirection * GameConstants.BITE_RANGE
	
	-- Send attack to server
	SharkController.SendAttackToServer(attackPosition, "BasicAttack")
	
	-- Visual effect
	SharkController.CreateAttackEffect(attackPosition)
end

function SharkController.PerformSecondaryAction()
	-- Placeholder for secondary action (block, special ability, etc.)
	GameUtilities.DebugPrint("SharkController: Secondary action performed")
end

function SharkController.CreateLeapEffect()
	if not humanoidRootPart then return end
	
	-- Create splash effect
	local splash = Instance.new("Part")
	splash.Name = "LeapSplash"
	splash.Size = Vector3.new(5, 1, 5)
	splash.Position = humanoidRootPart.Position
	splash.BrickColor = BrickColor.new("Light blue")
	splash.Material = Enum.Material.Water
	splash.Transparency = 0.5
	splash.Anchored = true
	splash.CanCollide = false
	
	splash.Parent = Workspace
	
	-- Remove effect after delay
	task.delay(2, function()
		if splash then
			splash:Destroy()
		end
	end)
end

function SharkController.CreateAttackEffect(position)
	-- Create bite effect
	local biteEffect = Instance.new("Part")
	biteEffect.Name = "BiteEffect"
	biteEffect.Size = Vector3.new(2, 2, 2)
	biteEffect.Position = position
	biteEffect.Shape = Enum.PartType.Ball
	biteEffect.BrickColor = BrickColor.new("Bright red")
	biteEffect.Material = Enum.Material.Neon
	biteEffect.Transparency = 0.3
	biteEffect.Anchored = true
	biteEffect.CanCollide = false
	
	biteEffect.Parent = Workspace
	
	-- Animate effect
	local startSize = biteEffect.Size
	local endSize = Vector3.new(4, 4, 4)
	
	for i = 1, 10 do
		local progress = i / 10
		biteEffect.Size = startSize:Lerp(endSize, progress)
		biteEffect.Transparency = 0.3 + (progress * 0.7)
		task.wait(0.05)
	end
	
	biteEffect:Destroy()
end

-- NETWORK COMMUNICATION
function SharkController.SendMovementToServer()
	if not humanoidRootPart then return end
	
	local remoteFolder = ReplicatedStorage:FindFirstChild("BattleSharksRemotes")
	if not remoteFolder then return end
	
	local moveEvent = remoteFolder:FindFirstChild("PlayerMove")
	if not moveEvent then return end
	
	local position = humanoidRootPart.Position
	local direction = humanoidRootPart.CFrame.LookVector
	
	moveEvent:FireServer(position, direction)
end

function SharkController.SendAttackToServer(targetPosition, attackType)
	local remoteFolder = ReplicatedStorage:FindFirstChild("BattleSharksRemotes")
	if not remoteFolder then return end
	
	local attackEvent = remoteFolder:FindFirstChild("PlayerAttack")
	if not attackEvent then return end
	
	attackEvent:FireServer(targetPosition, attackType)
end

function SharkController.SendBoostToServer()
	local remoteFolder = ReplicatedStorage:FindFirstChild("BattleSharksRemotes")
	if not remoteFolder then return end
	
	local boostEvent = remoteFolder:FindFirstChild("PlayerBoost")
	if not boostEvent then return end
	
	local direction = humanoidRootPart and humanoidRootPart.CFrame.LookVector or Vector3.forward
	boostEvent:FireServer(direction)
end

-- UTILITY FUNCTIONS
function SharkController.GetMovementState()
	return movementState
end

function SharkController.GetInputState()
	return inputState
end

function SharkController.IsUnderwater()
	return movementState.IsUnderwater
end

function SharkController.GetCurrentSpeed()
	return movementState.CurrentSpeed
end

function SharkController.SetSpeed(newSpeed)
	movementState.CurrentSpeed = newSpeed
end

-- CLEANUP
function SharkController.Cleanup()
	-- Reset physics
	Workspace.Gravity = physics.Gravity
	
	-- Clear references
	character = nil
	humanoid = nil
	humanoidRootPart = nil
	
	-- Reset state
	movementState.IsMoving = false
	movementState.IsBoosting = false
	movementState.IsUnderwater = false
	movementState.CurrentSpeed = 0
	movementState.TargetVelocity = Vector3.zero
	
	GameUtilities.DebugPrint("SharkController: Cleaned up")
end

return SharkController
