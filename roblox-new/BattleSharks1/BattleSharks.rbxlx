				Cooldown = 12,
				Duration = 5,
				Description = "Fire 3 harpoons in quick succession"
			},
			Ability2 = {
				Name = "Evasion Boost",
				Cooldown = 18,
				Duration = 4,
				Description = "Increase movement speed by 100% for 4 seconds"
			},
			Ultimate = {
				Name = "Torpedo Barrage",
				Cooldown = 45,
				Projectiles = 8,
				Damage = 25,
